#!/usr/bin/python3 -I
"""cdebconf passthrough protocol backend driving wros-install-core on NixOS.

Speaks the exact line-oriented cdebconf passthrough wire protocol expected by
the unchanged crates/wros-installer Rust TUI over DEBCONF_READFD / DEBCONF_WRITEFD:
  CAPB backup
  TITLE ...
  DATA <tag> type|description|extended_description|choices|choices-c ...
  SET <tag> ...
  INPUT critical <tag>
  GO
  GET <tag>
  PROGRESS START|STEP|SET|INFO|STOP ...

Collects keyboard layout, hostname, writer full name, username, writer password,
LUKS disk passphrase, and explicit disk-erase confirmation, then streams them via
stdin pipe (never argv or env) to /usr/libexec/wros-install-core.
"""
import json
import os
from pathlib import Path
import re
import subprocess
import sys

INSTALL_CORE = '/usr/libexec/wros-install-core'
BASELINE_JSON = Path('/run/wros-installer/baseline.json')
PROOF_OUT = Path('/run/wros-installer/wros-target-proof')
FINISHED_OUT = Path('/run/wros-installer/wros-target-finished')
FAILED_OUT = Path('/run/wros-installer/wros-target-failed')
LOADKEYS = '/usr/bin/loadkeys'
KEYMAPS_DIR = Path('/usr/share/wros/keymaps')
INSTALLER_CONSOLE = '/dev/tty7'
# The same rules wros-install-core enforces; checked here so a bad answer is asked again
# instead of failing after the erase confirmation (#139).
USERNAME_RE = re.compile(r'^[a-z_][a-z0-9_-]{0,31}$')
HOSTNAME_RE = re.compile(r'^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$')
RESERVED_USERNAMES = ('root', 'wros-live', 'live', 'builder', '_wros-installer', '_greetd')
STEP_PREFIX = 'wros-step '
REASON_LIMIT = 400


def escape(text):
    return str(text).replace('\\', '\\\\').replace('\n', '\\n')


class PassthroughChannel:
    def __init__(self, read_fd, write_fd):
        self.reader = os.fdopen(read_fd, 'r', encoding='utf-8', buffering=1, closefd=False)
        self.writer = os.fdopen(write_fd, 'w', encoding='utf-8', buffering=1, closefd=False)

    def send(self, command):
        self.writer.write(command + '\n')
        self.writer.flush()
        line = self.reader.readline()
        if not line:
            raise RuntimeError('frontend closed passthrough channel')
        line = line.rstrip('\n')
        code, _, value = line.partition(' ')
        return int(code), value

    def define(self, tag, kind, description, detail, choices=None, values=None, default=None):
        self.send(f'DATA {tag} type {kind}')
        self.send(f'DATA {tag} description {escape(description)}')
        self.send(f'DATA {tag} extended_description {escape(detail)}')
        if choices is not None and values is not None:
            self.send(f'DATA {tag} choices {", ".join(escape(c) for c in choices)}')
            self.send(f'DATA {tag} choices-c {", ".join(escape(v) for v in values)}')
        if default is not None:
            self.send(f'SET {tag} {escape(default)}')

    def ask(self, tag, kind, description, detail, choices=None, values=None, default=None):
        self.define(tag, kind, description, detail, choices=choices, values=values, default=default)
        self.send(f'INPUT critical {tag}')
        code, _ = self.send('GO')
        if code == 30:
            return None
        if code != 0:
            raise RuntimeError(f'GO returned unexpected status {code}')
        code, answer = self.send(f'GET {tag}')
        if code != 0:
            raise RuntimeError(f'GET {tag} returned status {code}')
        return answer


def hostname_problem(name):
    if HOSTNAME_RE.fullmatch(name) is None:
        return ('Use lowercase letters, numbers and hyphens only, starting and ending with a '
                'letter or number (for example: wros).')
    return None


def username_problem(name):
    if USERNAME_RE.fullmatch(name) is None:
        return ('Use lowercase letters, numbers, hyphens and underscores only, starting with a '
                'letter, at most 32 characters (for example: writer).')
    if name in RESERVED_USERNAMES:
        return f'{name} is reserved by WrOS. Choose another name.'
    return None


def password_problem(value):
    if len(value) < 8:
        return 'Use at least 8 characters.'
    if len(value) > 512 or '\n' in value or '\0' in value:
        return 'Use at most 512 characters, on one line.'
    return None


def apply_live_layout(layout, run=subprocess.run):
    """Switch the installer's own keyboard to the chosen layout at once, so the passwords typed
    next are the ones the unlock screen will expect (#133). Best effort: the install goes on
    with the old layout if the keymap cannot be loaded."""
    path = KEYMAPS_DIR / f'{layout}.map'
    if not path.is_file():
        return False
    try:
        res = run([LOADKEYS, '--unicode', f'--console={INSTALLER_CONSOLE}', str(path)],
                  stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                  check=False, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return res.returncode == 0


def redact(text, secrets):
    for secret in secrets:
        if secret:
            text = text.replace(secret, '[hidden]')
    return text


def run_dialog(channel, target_disk, session_nonce, core_runner=None, target_identity=None,
               layout_runner=None):
    channel.send('CAPB backup')
    channel.send('TITLE Install WrOS')

    steps = [
        'layout',
        'hostname',
        'full_name',
        'username',
        'user_password',
        'luks_passphrase',
        'confirm',
    ]
    answers = {
        'keyboard_layout': 'qwerty',
        'hostname': 'wros',
        'full_name': 'Writer',
        'username': 'writer',
        'user_password': '',
        'luks_passphrase': '',
        'timezone': 'UTC',
    }
    problems = {}
    idx = 0
    while idx < len(steps):
        step = steps[idx]
        if step == 'layout':
            ans = channel.ask(
                'wros/keyboard_layout', 'select',
                'Keyboard layout',
                'Choose the keyboard layout for the encrypted disk unlock prompt and writing session.',
                choices=['English (QWERTY)', 'Colemak', 'Colemak-DH (ANSI)', 'Colemak-DH (ISO)'],
                values=['qwerty', 'colemak', 'colemak-dh-ansi', 'colemak-dh-iso'],
                default=answers['keyboard_layout'],
            )
            if ans is None:
                continue
            answers['keyboard_layout'] = ans
            (layout_runner or apply_live_layout)(ans)
            idx += 1
        elif step == 'hostname':
            ans = channel.ask(
                'wros/hostname', 'string',
                'Appliance hostname',
                problems.get('hostname') or
                'Choose a short network name for this WrOS writing appliance: lowercase letters, '
                'numbers and hyphens (for example: wros).',
                default=answers['hostname'],
            )
            if ans is None:
                idx = max(0, idx - 1)
                continue
            answers['hostname'] = ans.strip() or 'wros'
            problems['hostname'] = hostname_problem(answers['hostname'])
            if problems['hostname'] is None:
                idx += 1
        elif step == 'full_name':
            ans = channel.ask(
                'wros/full_name', 'string',
                'Writer display name',
                'Enter your full name for the local writer account.',
                default=answers['full_name'],
            )
            if ans is None:
                idx = max(0, idx - 1)
                continue
            answers['full_name'] = ans.strip() or 'Writer'
            idx += 1
        elif step == 'username':
            ans = channel.ask(
                'wros/username', 'string',
                'Writer account username',
                problems.get('username') or
                'Enter a lowercase login name (for example: writer).',
                default=answers['username'],
            )
            if ans is None:
                idx = max(0, idx - 1)
                continue
            answers['username'] = ans.strip() or 'writer'
            problems['username'] = username_problem(answers['username'])
            if problems['username'] is None:
                idx += 1
        elif step == 'user_password':
            ans = channel.ask(
                'wros/user_password', 'password',
                'Writer account password',
                problems.get('user_password') or
                'Choose a password (at least 8 characters) for signing in and approving system settings.',
            )
            if ans is None:
                idx = max(0, idx - 1)
                continue
            answers['user_password'] = ans
            problems['user_password'] = password_problem(ans)
            if problems['user_password'] is None:
                idx += 1
        elif step == 'luks_passphrase':
            ans = channel.ask(
                'wros/luks_passphrase', 'password',
                'Disk encryption passphrase',
                problems.get('luks_passphrase') or
                f'Choose the LUKS2 encryption passphrase for /dev/{target_disk} (at least 8 characters). '
                'Required at every boot.',
            )
            if ans is None:
                idx = max(0, idx - 1)
                continue
            answers['luks_passphrase'] = ans
            problems['luks_passphrase'] = password_problem(ans)
            if problems['luks_passphrase'] is None:
                idx += 1
        elif step == 'confirm':
            ans = channel.ask(
                'wros/confirm_erase', 'boolean',
                f'Erase /dev/{target_disk} and install encrypted WrOS?',
                f'All existing data on /dev/{target_disk} will be permanently replaced with an encrypted WrOS installation.',
                default='false',
            )
            if ans is None:
                idx = max(0, idx - 1)
                continue
            if ans != 'true':
                raise SystemExit(2)
            idx += 1

    channel.define('wros/progress', 'text', 'Installing WrOS',
                   'Encrypting the disk and copying WrOS onto it. This takes a few minutes.')
    channel.send('PROGRESS START 0 100 wros/progress')
    channel.send('PROGRESS SET 20')

    payload = {
        'target_disk': target_disk,
        'target_identity': target_identity,
        'session_nonce': session_nonce,
        **answers,
    }
    if core_runner is None:
        def core_runner(payload):
            return _default_core_runner(payload, lambda percent, text: show_step(channel, percent, text))
    try:
        proof = core_runner(payload)
    except Exception as exc:
        reason = redact(str(exc), (answers['user_password'], answers['luks_passphrase']))
        reason = reason if len(reason) <= REASON_LIMIT else reason[:REASON_LIMIT] + '…'
        channel.send('PROGRESS STOP')
        # Shown before the failure marker is written: the session closes the screens as soon as
        # it sees the marker (#135).
        channel.ask('wros/failed', 'note', 'WrOS was not installed',
                    f'{reason}\n\nThe live session will return, and you can try again.')
        FAILED_OUT.write_text(reason + '\n', encoding='utf-8')
        raise RuntimeError(reason) from None
    channel.send('PROGRESS SET 100')
    channel.send('PROGRESS STOP')
    channel.ask(
        'wros/complete', 'note',
        'Encrypted WrOS installation complete',
        'Remove the installation media after the appliance returns to the live session and reboot.',
    )
    return proof


def show_step(channel, percent, text):
    channel.define('wros/step', 'text', text, '')
    channel.send('PROGRESS INFO wros/step')
    channel.send(f'PROGRESS SET {max(0, min(100, int(percent)))}')


def follow_core(stderr_lines, on_step):
    """Pass "wros-step N TEXT" lines to the screen; keep the rest for the error and the log."""
    kept = []
    for raw in stderr_lines:
        line = raw.decode('utf-8', 'replace') if isinstance(raw, bytes) else raw
        line = line.rstrip('\n')
        if line.startswith(STEP_PREFIX):
            percent, _, text = line[len(STEP_PREFIX):].partition(' ')
            if percent.isdigit():
                on_step(int(percent), text.strip())
                continue
        if line:
            print(line, file=sys.stderr, flush=True)  # the session sends this to the journal
            kept.append(line)
            del kept[:-20]
    return kept


def _default_core_runner(payload, on_step=lambda percent, text: None):
    process = subprocess.Popen(
        [INSTALL_CORE],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    process.stdin.write(json.dumps(payload).encode('utf-8'))
    process.stdin.close()
    kept = follow_core(process.stderr, on_step)
    out = process.stdout.read()
    code = process.wait()
    if code != 0:
        message = kept[-1] if kept else f'install-core exited with status {code}'
        raise RuntimeError(message.removeprefix('wros-install-core: '))
    proof = json.loads(out.decode('utf-8'))
    PROOF_OUT.write_text(json.dumps(proof, sort_keys=True) + '\n', encoding='utf-8')
    os.chmod(PROOF_OUT, 0o600)
    FINISHED_OUT.write_text('completed\n', encoding='utf-8')
    return proof


def main():
    read_fd = int(os.environ['DEBCONF_READFD'])
    write_fd = int(os.environ['DEBCONF_WRITEFD'])
    baseline = json.loads(BASELINE_JSON.read_bytes())
    channel = PassthroughChannel(read_fd, write_fd)
    run_dialog(channel, baseline['target_disk'], baseline['session_nonce'],
               target_identity=baseline['target_identity'])
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except SystemExit:
        raise
    except Exception as exc:
        print(f'wros-installer-backend: {exc}', file=sys.stderr)
        raise SystemExit(1) from None
