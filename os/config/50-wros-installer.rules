// Only the live-session wros-live account on an active local console may start the supervised installer.
polkit.addRule(function(action, subject) {
    if (action.id == "org.wros.installer" && subject.user == "wros-live" &&
        subject.local && subject.active && subject.isInGroup("writingdeck")) {
        return polkit.Result.YES;
    }
});
