# Keep Debian's interactive disk, encryption, locale, keyboard and password
# screens. Never add a target disk, password, partition recipe or confirmation.
d-i passwd/root-login boolean false
d-i passwd/make-user boolean true
d-i passwd/user-default-groups string audio cdrom dip video plugdev netdev sudo wros writingdeck
# Copy the complete offline squashfs, including firmware and prose resources.
d-i live-installer/enable boolean true
# Bootstrap from the media without requiring a time server or Debian mirror.
# Network setup stays interactive. The live system may use network time and
# check for updates, and normal Debian sources are restored on the installed
# system for additional drivers/packages when a connection is available.
d-i clock-setup/ntp boolean false
d-i apt-setup/use_mirror boolean false
d-i apt-setup/services-select multiselect
popularity-contest popularity-contest/participate boolean false
