// Staged only with the experimental native greeter. No group membership or
// authorization for display, power, shells, systemctl or other executables.
// The login screen's power menu needs none: logind's own policy already lets
// the greeter's active local session shut down and restart.
polkit.addRule(function(action, subject) {
    if ((action.id == "org.wros.keyboard" || action.id == "org.writingdeck.keyboard") &&
        subject.user == "_greetd" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
