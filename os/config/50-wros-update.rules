// Only the fixed validated update and import helpers; never a general command or device grant.
// The in-app confirmation screen (default Cancel) is the human gate for updates.
polkit.addRule(function(action, subject) {
    var actions = ["org.wros.update.stage", "org.wros.update.cancel",
                   "org.wros.update.repair", "org.wros.update.media",
                   "org.wros.update.fetch", "org.wros.update.apply",
                   "org.wros.update.rollback", "org.wros.update.healthy",
                   "org.wros.import.media"];
    if (actions.indexOf(action.id) >= 0 && subject.local && subject.active &&
        (subject.isInGroup("wros") && subject.isInGroup("writingdeck"))) {
        return polkit.Result.YES;
    }
});
