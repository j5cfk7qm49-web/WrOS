# Explicit console service: package drop-ins cannot remove its tty7 dependency.
[Unit]
Description=WrOS native login with greetd and PAM
After=systemd-user-sessions.service console-setup.service wros-keyboard.service getty@tty1.service
Wants=wros-keyboard.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
Type=simple
# The start screen's progress bar (docs/RATATUI_BOOT.md) hands tty1 over; "-": never a reason
# for the login not to start.
ExecStartPre=-/usr/bin/systemctl stop wros-boot-splash.service
ExecStart=/usr/sbin/greetd
IgnoreSIGPIPE=no
SendSIGHUP=yes
TimeoutStopSec=30s
KeyringMode=shared
Restart=always
RestartSec=2
LimitCORE=0

[Install]
WantedBy=multi-user.target
