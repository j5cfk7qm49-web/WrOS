# Debian's brightnessctl is built without logind and ships no udev rule, so the
# backlight stays root-only. Upstream's rule: the video group (the writer and
# wros-live) may write the screen backlight's brightness, nothing else.
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/usr/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/usr/bin/chmod g+w /sys/class/backlight/%k/brightness"
