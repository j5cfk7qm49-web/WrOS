@@ -58,0 +59,12 @@
+
+/* A protocol frame is one line. Escape backslashes before newlines in
+ * every field, including progress and substitutions, so neither paragraphs
+ * nor a literal backslash-n can change framing or lose their meaning. */
+static char *
+encode_field(const char *text)
+{
+    char *slashes = strreplace(text ? text : "", "\\", "\\\\");
+    char *encoded = strreplace(slashes, "\n", "\\n");
+    free(slashes);
+    return encoded;
+}
