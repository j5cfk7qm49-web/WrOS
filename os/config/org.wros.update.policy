<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>WrOS — Writer's OS</vendor>
  <action id="org.wros.update">
    <description>Stage signed offline updates or recover interrupted package state</description>
    <message>Authorize a WrOS signed update or package recovery action</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>no</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/wros-update</annotate>
  </action>
</policyconfig>
