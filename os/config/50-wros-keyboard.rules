// Exact narrow helper only. No general sudo, shell, localectl or systemctl grants.
polkit.addRule(function(action, subject) {
    if ((action.id == "org.wros.keyboard" || action.id == "org.writingdeck.keyboard") &&
        subject.local && subject.active && (subject.isInGroup("wros") && subject.isInGroup("writingdeck"))) {
        return polkit.Result.YES;
    }
});
