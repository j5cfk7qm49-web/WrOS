[Unit]
Description=WrOS start screen: the logo and boot progress until the login screen
Documentation=file:/usr/share/doc/wros/RATATUI_BOOT.md
DefaultDependencies=no
After=systemd-vconsole-setup.service console-setup.service
# The login screen stops this just before it takes tty1 (ExecStartPre in greetd.service).
# No Conflicts= with it: both start in the same boot transaction, and systemd would drop
# one of two conflicting jobs, which could be the login screen. And no Before= either:
# a stop ordered against greetd's own start can't run from greetd's ExecStartPre.
Before=shutdown.target
Conflicts=shutdown.target
# Only while the start screen is switched on, and never on a plain text start
# (the WrOS recovery entry passes wros.unlock=text, so its messages stay visible).
ConditionKernelCommandLine=!wros.unlock=text

[Service]
Type=simple
ExecCondition=/bin/sh -c 'test ! -e /etc/wros/boot-screen || test "$(cat /etc/wros/boot-screen)" = ratatui'
ExecStart=/usr/lib/wros/wros-boot splash --tty /dev/tty1
TimeoutStopSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=sysinit.target
