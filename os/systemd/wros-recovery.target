[Unit]
Description=WrOS recovery
Documentation=file:/usr/share/doc/wros/RC_RESCUE.md
# Booted from the "WrOS recovery" menu entry (systemd.unit=wros-recovery.target): the system's
# basic services and the recovery menu on tty1, with no login screen and no network unless the
# menu is asked to start it. A staged offline update is not applied in recovery.
Requires=basic.target wros-recovery.service
After=basic.target wros-recovery.service
Conflicts=rescue.service rescue.target greetd.service getty@tty1.service
AllowIsolate=yes
