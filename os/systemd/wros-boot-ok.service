[Unit]
Description=Record that this boot reached the WrOS login screen
# GRUB marks every boot as pending (/etc/grub.d/06_wros_boot_check); a boot that never gets here
# shows the boot menu, with WrOS recovery, next time. Powering off at the login screen is a good
# boot. Where /boot is not writable by GRUB the mark is never set and this changes nothing.
After=greetd.service
ConditionPathExists=/boot/grub/grubenv

[Service]
Type=oneshot
ExecStart=/usr/bin/grub-editenv /boot/grub/grubenv unset wros_boot_pending
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/boot/grub
NoNewPrivileges=yes
PrivateNetwork=yes

[Install]
WantedBy=multi-user.target
