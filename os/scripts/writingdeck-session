#!/bin/sh
# Runs as the authenticated writer, never root. Normal Linux mode can simply
# invoke `grimoire`; this wrapper is for the dedicated console appliance.
set -eu
if [ "$(id -u)" -eq 0 ]; then
    echo 'Refusing to run the writing application as root.' >&2
    exit 1
fi
export LANG=C.UTF-8
export TERM="${TERM:-linux}"
export WRITINGDECK_OS=1
if [ -f /run/wros-live/session.json ] || [ -f /run/live/medium/live/filesystem.squashfs ]; then
    export WROS_LIVE_SESSION=1
fi
umask 077
# Journal marker proves a non-root console session was reached; it is not a
# substitute for the VM test's actual rendered-screen assertion.
logger -t writingdeck-session "WRITINGDECK_SESSION uid=$(id -u) tty=$(tty)"
# While a new WrOS version is on probation, record that a writer logged in. The app reports
# "ready" once it drew its first screen; two logins that never get there go back a version.
if grep -q '"probation": true' /var/lib/wros-update/public/status.json 2>/dev/null; then
    pkexec --disable-internal-agent /usr/libexec/wros-update-healthy started >/dev/null 2>&1 || true
fi
# Exit returns to a login prompt rather than exposing an authenticated shell.
exec /usr/bin/grimoire
