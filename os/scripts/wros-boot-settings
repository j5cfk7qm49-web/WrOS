#!/usr/bin/python3 -I
"""Fixed start-screen files and a queued boot-image rebuild. No user file paths."""
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import tomllib

ROLES = {'accent', 'text', 'dim', 'border', 'selection', 'warning', 'sun', 'moon',
         'foliage', 'bark', 'bloom', 'turf'}
ENV = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C'}


def theme_data(text):
    if len(text.encode()) > 4096:
        raise ValueError('The theme is too long.')
    try:
        values = tomllib.loads(text)
    except tomllib.TOMLDecodeError:
        raise ValueError('The theme could not be read.') from None
    if not values.get('name') or values.keys() - (ROLES | {'name', 'pomodoro', 'visualizer'}):
        raise ValueError('The theme has an unknown setting.')
    for key, value in values.items():
        if not isinstance(value, str) or not 1 <= len(value) <= 64 or any(ord(c) < 32 for c in value):
            raise ValueError('The theme has an invalid setting.')
        if key in ROLES and not re.fullmatch(r'#[0-9a-fA-F]{6}', value):
            raise ValueError('The theme has an invalid colour.')
    return text.encode()


def regular(path):
    if path.is_symlink() or (path.exists() and not path.is_file()):
        raise ValueError('The start-screen settings could not be changed.')


def atomic(path, data):
    regular(path)
    descriptor, name = tempfile.mkstemp(prefix='.boot-', dir=path.parent)
    temporary = Path(name)
    try:
        with os.fdopen(descriptor, 'wb') as output:
            os.fchmod(output.fileno(), 0o644)
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        descriptor = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    finally:
        temporary.unlink(missing_ok=True)


class Settings:
    def __init__(self, config, state, run=subprocess.run):
        self.config, self.state, self.run = config, state, run

    def lock(self):
        for directory in (self.config, self.state):
            if directory.is_symlink():
                raise ValueError('The start-screen settings could not be changed.')
            directory.mkdir(parents=True, exist_ok=True)
        descriptor = os.open(self.state / 'lock', os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        lock = os.fdopen(descriptor, 'w')
        fcntl.flock(lock, fcntl.LOCK_EX)
        return lock

    def status(self):
        switch = self.config / 'boot-screen'
        regular(switch)
        enabled = not switch.exists() or switch.read_bytes().strip() == b'ratatui'
        return {'enabled': enabled,
                'pending': (self.state / 'pending').exists() or (self.state / 'building').exists(),
                'failed': (self.state / 'failed').exists()}

    def change(self, operation, *args):
        if operation == 'theme' and len(args) == 1:
            data = theme_data(args[0])
            enabled = None
        elif operation == 'screen' and len(args) == 2 and args[0] in ('ratatui', 'text'):
            data = theme_data(args[1])
            enabled = args[0] == 'ratatui'
        else:
            raise ValueError('Choose WrOS or plain text.')
        with self.lock():
            regular(self.config / 'boot-screen')
            atomic(self.config / 'boot-theme.toml', data)
            if enabled is True:
                atomic(self.config / 'boot-screen', b'ratatui\n')
            elif enabled is False:
                atomic(self.config / 'boot-screen', b'text\n')
            atomic(self.state / 'pending', b'pending\n')
        # The path unit starts the service and notices changes made during a build too.
        done = self.run(['/usr/bin/systemctl', 'start', '--no-block', 'wros-boot-rebuild.path'],
                        env=ENV, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL, timeout=5)
        if done.returncode:
            raise RuntimeError('The choice is saved. The start screen could not be prepared. Try again.')
        return self.status()

    def rebuild(self):
        with self.lock():
            if not (self.state / 'pending').exists() and not (self.state / 'building').exists():
                return
            atomic(self.state / 'building', b'building\n')
            (self.state / 'pending').unlink(missing_ok=True)
        succeeded = False
        try:
            done = self.run(['/usr/sbin/update-initramfs', '-u', '-k', 'all'], env=ENV,
                            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, timeout=900)
            succeeded = done.returncode == 0
        finally:
            with self.lock():
                (self.state / 'building').unlink(missing_ok=True)
                if succeeded:
                    (self.state / 'failed').unlink(missing_ok=True)
                else:
                    atomic(self.state / 'failed', b'failed\n')
        if not succeeded:
            raise RuntimeError('The start screen could not be prepared. Try the choice again.')


def main(args):
    if os.geteuid() != 0:
        raise ValueError('The start-screen service needs authorization.')
    settings = Settings(Path('/etc/wros'), Path('/var/lib/wros/boot-screen'))
    if args == ['rebuild']:
        settings.rebuild()
    elif args == ['status']:
        print(json.dumps(settings.status()))
    elif args:
        print(json.dumps(settings.change(args[0], *args[1:])))
    else:
        raise ValueError('Choose WrOS or plain text.')


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except (ValueError, RuntimeError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
    except (OSError, subprocess.SubprocessError):
        print('The start screen could not be prepared. Try the choice again.', file=sys.stderr)
        sys.exit(1)
