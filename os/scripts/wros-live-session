#!/usr/bin/python3 -I
"""Prepare only the explicitly selected live session; never edit installed auth."""
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile
import tomllib

USER, UID, HOME = 'wros-live', 1000, '/home/wros-live'
BASE_CONFIG = {'terminal': {'vt': 1, 'switch': True},
               'general': {'source_profile': False},
               'default_session': {'command': '/usr/bin/wros-greeter', 'user': '_greetd'}}
MANUAL = {'live-config.noautologin', 'noautologin',
          'live-config.nottyautologin', 'nottyautologin'}
ENV = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8', 'LC_ALL': 'C.UTF-8'}


def require(condition):
    if not condition:
        raise ValueError('live session precondition failed')


def render(base, passwd, user_status, root_status, cmdline, boot_id, manual=False):
    words = cmdline.split()
    if 'boot=live' not in words or 'wros.live=1' not in words:
        return None
    require([s for s in words if s.startswith('boot=')] == ['boot=live'])
    require([s for s in words if s.startswith('wros.live=')] == ['wros.live=1'])
    require(len(base) <= 65536 and tomllib.loads(base.decode()) == BASE_CONFIG)
    require(re.fullmatch(r'[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}', boot_id))
    accounts = [line.split(':') for line in passwd.splitlines()]
    users = [a for a in accounts if len(a) == 7 and (a[0] == USER or a[2] == str(UID))]
    require(len(users) == 1)
    user = users[0]
    require(user[0] == USER and user[2:4] == [str(UID), str(UID)]
            and user[5:] == [HOME, '/bin/bash'])
    require(user_status.split()[:2] == [USER, 'P'] and root_status.split()[:2] == ['root', 'L'])
    automatic = not manual and not MANUAL.intersection(words)
    configuration = base
    if automatic:
        configuration += (b'\n# Temporary live entry; the source configuration remains authenticated.\n'
                          b'[initial_session]\ncommand = "/usr/libexec/writingdeck-session"\n'
                          b'user = "wros-live"\n')
    marker = {'version': 1, 'boot_id': boot_id, 'user': USER, 'uid': UID,
              'home': HOME, 'automatic': automatic}
    return {'greetd.toml': (configuration, 0o600),
            'session.json': ((json.dumps(marker, sort_keys=True) + '\n').encode(), 0o644),
            'greetd.env': (b'WROS_GREETD_CONFIG=/run/wros-live/greetd.toml\n', 0o644)}


def trusted(path, owner=0, directory=False):
    info = path.lstat()
    require(not path.is_symlink() and info.st_uid == owner and not info.st_mode & 0o022)
    require(stat.S_ISDIR(info.st_mode) if directory else stat.S_ISREG(info.st_mode))


def install_runtime(directory, files, owner=0):
    require(set(files) == {'greetd.toml', 'session.json', 'greetd.env'})
    directory.mkdir(mode=0o755, exist_ok=True)
    trusted(directory, owner, directory=True)
    for name, (contents, mode) in files.items():
        path = directory / name
        if path.exists() or path.is_symlink():
            trusted(path, owner)
            require(path.read_bytes() == contents and stat.S_IMODE(path.stat().st_mode) == mode)
    # Publish the environment pointer last, after the live marker and config.
    for name in ('greetd.toml', 'session.json', 'greetd.env'):
        contents, mode = files[name]
        path = directory / name
        if path.exists() or path.is_symlink():
            continue
        temporary = None
        try:
            with tempfile.NamedTemporaryFile(dir=directory, prefix='.prepare-', delete=False) as stream:
                temporary = Path(stream.name)
                stream.write(contents)
                stream.flush()
                os.fchmod(stream.fileno(), mode)
                os.fsync(stream.fileno())
            os.replace(temporary, path)
        finally:
            if temporary is not None:
                temporary.unlink(missing_ok=True)


def status(name):
    reply = subprocess.run(['/usr/bin/passwd', '-S', name], stdin=subprocess.DEVNULL,
                           capture_output=True, env=ENV, check=True, timeout=5)
    require(len(reply.stdout) <= 4096 and len(reply.stderr) <= 4096)
    return reply.stdout.decode('ascii')


def main():
    require(os.geteuid() == 0 and len(sys.argv) == 1)
    cmdline = Path('/proc/cmdline').read_text()
    if 'boot=live' not in cmdline.split() or 'wros.live=1' not in cmdline.split():
        return
    medium = Path('/run/live/medium').resolve(strict=True)
    require((medium / 'live/filesystem.squashfs').is_file())
    require(os.statvfs(medium).f_flag & os.ST_RDONLY)
    mounts = Path('/proc/self/mountinfo').read_text().splitlines()
    require(any(line.split()[4] == str(medium) for line in mounts))
    base = Path('/etc/greetd/config.toml')
    trusted(base)
    require(not Path('/etc/writingdeck/VM-DEMO-ONLY').exists())
    passwd = Path('/etc/passwd').read_bytes()
    require(len(passwd) <= 1024 * 1024)
    files = render(base.read_bytes(), passwd.decode(), status(USER), status('root'), cmdline,
                   Path('/proc/sys/kernel/random/boot_id').read_text().strip(),
                   os.environ.get('LIVE_CONFIG_NOAUTOLOGIN') == 'true'
                   or os.environ.get('LIVE_CONFIG_NOTTYAUTOLOGIN') == 'true')
    require(files is not None)
    install_runtime(Path('/run/wros-live'), files)


if __name__ == '__main__':
    try:
        main()
    except Exception:
        print('WrOS live session setup failed.', file=sys.stderr)
        raise SystemExit(1) from None
