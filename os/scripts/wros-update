#!/usr/bin/python3 -I
"""Entry point for the WrOS update engine: unprivileged verbs and the two systemd roles.

Verbs: recovery-status, review <abs-dir>, verify-bundle <abs-dir>.  run-offline-boot and
reconcile are reserved for systemd and refuse a pkexec caller.  Everything else fails
closed.  The engine is a root-owned module at a fixed path (-I ignores the environment
and this directory), and it is the only code that decides.
"""
import importlib.machinery
import importlib.util
import sys

ENGINE = '/usr/lib/wros-update/engine.py'


def load_engine(path=None):
    loader = importlib.machinery.SourceFileLoader('wros_update_engine', path or ENGINE)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def main(argv=None, engine_path=None):
    return load_engine(engine_path).main(argv)


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, ValueError, ImportError, SyntaxError) as exc:
        print(str(exc), file=sys.stderr)
        raise SystemExit(1) from None
    except Exception as exc:  # subprocess errors from the engine
        print(str(exc), file=sys.stderr)
        raise SystemExit(1) from None
