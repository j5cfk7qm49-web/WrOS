#!/usr/bin/python3 -I
"""Signed bundle verification, POSIX dpkg lock coordination, and offline boot update engine.

Uses gpgv on sealed metadata copies to authenticate Release/InRelease and
Packages hashes, dpkg --compare-versions for anti-downgrade and dependency
relation checks, and POSIX F_GETLK / F_SETLK record locks on
/var/lib/dpkg/lock-frontend and /var/lib/dpkg/lock. Interactive root mutations
remain refused until VM interruption qualification completes; the offline boot
service role runs only under systemd PID 1 at system-update.target.
"""
from contextlib import contextmanager
from datetime import datetime, timedelta, timezone
from email.utils import parsedate_to_datetime
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import shutil
import stat
import struct
import subprocess
import sys
import tempfile

LIMIT = 16 * 1024 * 1024
DEFAULT_KEYRING = Path('/usr/share/keyrings/debian-archive-keyring.gpg')
DEFAULT_STATE_DIR = Path('/var/lib/wros-update')
DEFAULT_TRIGGER = Path('/system-update')
DEFAULT_DPKG_DIR = Path('/var/lib/dpkg')
PACKAGE_NAME_RE = re.compile(r'^[a-z0-9][a-z0-9+.-]{0,127}$')
VERSION_RE = re.compile(r'^[0-9][A-Za-z0-9.+:~-]{0,127}$')
ARCH_RE = re.compile(r'^[a-z0-9-]{2,32}$')
HEX64_RE = re.compile(r'^[0-9a-f]{64}$')
SAFE_REL_RE = re.compile(r'^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*\.deb$')
DEP_TOKEN_RE = re.compile(
    r'^\s*([a-z0-9][a-z0-9+.-]{0,127})(?::[a-z0-9-]+)?'
    r'(?:\s*\(\s*(<<|<=|=|>=|>>)\s*([0-9][A-Za-z0-9.+:~-]{0,127})\s*\))?\s*$'
)
REL_TO_DPKG = {'<<': 'lt', '<=': 'le', '=': 'eq', '>=': 'ge', '>>': 'gt'}


def fail(message):
    raise ValueError(message)


def atomic_write(path, data, mode=0o600):
    path = Path(path)
    path.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    temporary = path.with_name(f'.{path.name}.{secrets.token_hex(8)}.tmp')
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    try:
        with os.fdopen(descriptor, 'wb') as output:
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        parent = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(parent)
        finally:
            os.close(parent)
    finally:
        temporary.unlink(missing_ok=True)


def json_write(path, value, mode=0o600):
    atomic_write(path, (json.dumps(value, indent=2, sort_keys=True) + '\n').encode('utf-8'), mode)


def regular_stream(path):
    # No blocking FIFOs or final-component symlink races in caller-owned media.
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            fail(f'update input is not a regular file: {path.name}')
        return os.fdopen(descriptor, 'rb')
    except BaseException:
        os.close(descriptor)
        raise


def read_regular_bytes(path, limit=LIMIT):
    if path.is_symlink() or not path.is_file():
        fail(f'missing or symlinked update file: {path.name}')
    with regular_stream(path) as stream:
        data = stream.read(limit + 1)
    if len(data) > limit:
        fail(f'oversized update file: {path.name}')
    return data


def sha256_file(path):
    if path.is_symlink() or not path.is_file():
        fail(f'missing or symlinked archive: {path.name}')
    digest = hashlib.sha256()
    size = 0
    with regular_stream(path) as stream:
        while chunk := stream.read(65536):
            size += len(chunk)
            if size > 1024 * 1024 * 1024:
                fail(f'update archive exceeds 1 GiB limit: {path.name}')
            digest.update(chunk)
    return digest.hexdigest(), size


def compare_dpkg_versions(left, op, right):
    if VERSION_RE.fullmatch(left) is None or VERSION_RE.fullmatch(right) is None:
        fail('invalid Debian package version for comparison')
    if op not in ('lt', 'le', 'eq', 'ne', 'ge', 'gt'):
        fail(f'invalid dpkg version operator: {op}')
    res = subprocess.run(
        ['/usr/bin/dpkg', '--compare-versions', left, op, right],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=5,
        env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C'},
    )
    return res.returncode == 0


def parse_dependency_field(field_text):
    """Parse a Debian Depends/Pre-Depends/Breaks/Conflicts field into OR-clauses."""
    if not field_text or not field_text.strip():
        return []
    clauses = []
    for raw_clause in field_text.split(','):
        raw_clause = raw_clause.strip()
        if not raw_clause:
            continue
        alternatives = []
        for raw_alt in raw_clause.split('|'):
            match = DEP_TOKEN_RE.fullmatch(raw_alt)
            if match is None:
                fail(f'invalid Debian dependency expression: {raw_alt!r}')
            pkg_name, rel, ver = match.groups()
            alternatives.append((pkg_name, rel, ver))
        clauses.append(alternatives)
    return clauses


def extract_inrelease_payload(raw_bytes):
    text = raw_bytes.decode('utf-8', errors='strict')
    if '\r' in text:
        fail('InRelease must use LF line endings')
    lines = text.splitlines()
    if not lines or lines[0] != '-----BEGIN PGP SIGNED MESSAGE-----':
        fail('invalid InRelease cleartext header')
    idx = 1
    while idx < len(lines) and lines[idx] != '':
        idx += 1
    if idx >= len(lines):
        fail('InRelease missing header separator')
    idx += 1
    body = []
    found_sig = False
    while idx < len(lines):
        line = lines[idx]
        if line == '-----BEGIN PGP SIGNATURE-----':
            found_sig = True
            break
        if line.startswith('- '):
            line = line[2:]
        body.append(line)
        idx += 1
    if not found_sig or not body:
        fail('InRelease missing PGP signature block')
    return '\n'.join(body) + '\n'


def parse_release_sha256(release_text, now=None):
    suite = ''
    date_raw = None
    valid_until_raw = None
    in_sha256 = False
    entries = {}
    for line in release_text.splitlines():
        if line.startswith('Suite:'):
            suite = line.partition(':')[2].strip()
            in_sha256 = False
        elif line.startswith('Codename:') and not suite:
            suite = line.partition(':')[2].strip()
            in_sha256 = False
        elif line.startswith('Date:'):
            date_raw = line.partition(':')[2].strip()
            in_sha256 = False
        elif line.startswith('Valid-Until:'):
            valid_until_raw = line.partition(':')[2].strip()
            in_sha256 = False
        elif line.startswith('SHA256:'):
            in_sha256 = True
        elif line.startswith(' ') and in_sha256:
            parts = line.split()
            if len(parts) != 3:
                fail('malformed SHA256 entry in signed Release metadata')
            digest, size_str, relpath = parts
            if HEX64_RE.fullmatch(digest) is None or not size_str.isdigit():
                fail('invalid SHA256 digest or byte count in signed Release metadata')
            if relpath.startswith('/') or '..' in Path(relpath).parts:
                fail('unsafe path in signed Release metadata')
            entries[relpath] = (digest, int(size_str))
        elif line and not line.startswith(' '):
            in_sha256 = False
    if not entries:
        fail('signed Release metadata contains no SHA256 file entries')
    reference_now = now or datetime.now(timezone.utc)
    if date_raw is not None:
        try:
            release_dt = parsedate_to_datetime(date_raw)
        except Exception:
            fail('invalid Date header in signed Release metadata')
        if release_dt.tzinfo is None:
            release_dt = release_dt.replace(tzinfo=timezone.utc)
        if release_dt > reference_now + timedelta(minutes=5):
            fail('signed Release metadata Date is in the future')
    if valid_until_raw is not None:
        try:
            until_dt = parsedate_to_datetime(valid_until_raw)
        except Exception:
            fail('invalid Valid-Until header in signed Release metadata')
        if until_dt.tzinfo is None:
            until_dt = until_dt.replace(tzinfo=timezone.utc)
        if until_dt <= reference_now:
            fail('signed Release metadata has expired (Valid-Until passed)')
    return suite or 'debian', entries


def parse_packages_index(packages_text):
    if '\0' in packages_text or '\r' in packages_text:
        fail('invalid Packages index encoding')
    packages = []
    seen_names = set()
    seen_files = set()
    for raw_stanza in packages_text.strip().split('\n\n'):
        if not raw_stanza.strip():
            continue
        fields = {}
        for line in raw_stanza.splitlines():
            if line.startswith((' ', '\t')) or ':' not in line:
                continue
            key, _, value = line.partition(':')
            fields[key.strip()] = value.strip()
        name = fields.get('Package', '')
        version = fields.get('Version', '')
        arch = fields.get('Architecture', '')
        filename = fields.get('Filename', '')
        size_str = fields.get('Size', '')
        sha256 = fields.get('SHA256', '')
        if PACKAGE_NAME_RE.fullmatch(name) is None:
            fail(f'invalid Debian package name in Packages: {name!r}')
        if VERSION_RE.fullmatch(version) is None:
            fail(f'invalid Debian package version in Packages: {version!r}')
        if ARCH_RE.fullmatch(arch) is None:
            fail(f'invalid Debian package architecture in Packages: {arch!r}')
        if SAFE_REL_RE.fullmatch(filename) is None or '..' in Path(filename).parts:
            fail(f'unsafe Debian archive path in Packages: {filename!r}')
        if not size_str.isdigit() or int(size_str) <= 0:
            fail(f'invalid Debian archive size in Packages: {size_str!r}')
        if HEX64_RE.fullmatch(sha256) is None:
            fail(f'invalid Debian archive SHA256 in Packages: {sha256!r}')
        if name in seen_names or filename in seen_files:
            fail(f'duplicate package or archive in Packages: {name}')
        seen_names.add(name)
        seen_files.add(filename)
        depends = (
            parse_dependency_field(fields.get('Pre-Depends', ''))
            + parse_dependency_field(fields.get('Depends', ''))
        )
        conflicts = (
            parse_dependency_field(fields.get('Breaks', ''))
            + parse_dependency_field(fields.get('Conflicts', ''))
        )
        provides = []
        for clause in parse_dependency_field(fields.get('Provides', '')):
            for prov_name, prov_rel, prov_ver in clause:
                if prov_rel and prov_rel != '=':
                    fail(f'invalid versioned Provides in Packages: {prov_name}')
                provides.append((prov_name, prov_ver))
        packages.append({
            'name': name,
            'version': version,
            'architecture': arch,
            'filename': filename,
            'size': int(size_str),
            'sha256': sha256,
            'depends': depends,
            'conflicts': conflicts,
            'provides': provides,
        })
    if not packages:
        fail('signed Packages index contains no installable packages')
    if len(packages) > 256:
        fail('update bundle exceeds 256 package limit')
    return packages


def verify_gpgv(bundle_dir, keyring=DEFAULT_KEYRING):
    keyring = Path(keyring)
    if keyring.is_symlink() or not keyring.is_file():
        fail(f'missing or symlinked update verification keyring: {keyring}')
    inrelease = bundle_dir / 'InRelease'
    release = bundle_dir / 'Release'
    release_gpg = bundle_dir / 'Release.gpg'
    clearsigned = inrelease.exists()
    if clearsigned:
        raw = read_regular_bytes(inrelease, 1024 * 1024)
        cmd = ['/usr/bin/gpgv', '--status-fd', '1', '--keyring', str(keyring), 'InRelease']
        release_text = extract_inrelease_payload(raw)
    elif release.exists() and release_gpg.exists():
        raw = read_regular_bytes(release, 1024 * 1024)
        signature = read_regular_bytes(release_gpg, 65536)
        if b'\r' in raw:
            fail('Release must use LF line endings')
        cmd = ['/usr/bin/gpgv', '--status-fd', '1', '--keyring', str(keyring), 'Release.gpg', 'Release']
        release_text = raw.decode('utf-8', errors='strict')
    else:
        fail('update bundle requires signed InRelease or Release + Release.gpg')
    with tempfile.TemporaryDirectory(prefix='wros-update-metadata-') as temporary:
        directory = Path(temporary)
        if clearsigned:
            (directory / 'InRelease').write_bytes(raw)
        else:
            (directory / 'Release').write_bytes(raw)
            (directory / 'Release.gpg').write_bytes(signature)
        result = subprocess.run(
            cmd,
            cwd=directory,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=10,
            env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C'},
        )
    if result.returncode != 0:
        fail('GPG signature verification failed for update bundle')
    goodsig = False
    validsig = None
    for line in result.stdout.splitlines():
        if line.startswith('[GNUPG:] GOODSIG '):
            goodsig = True
        elif line.startswith('[GNUPG:] VALIDSIG '):
            parts = line.split()
            if len(parts) >= 3 and re.fullmatch(r'[0-9A-Fa-f]{16,64}', parts[2]):
                validsig = parts[2].upper()
    if not goodsig or not validsig:
        fail('gpgv did not confirm a valid signature on update metadata')
    return validsig, release_text


def load_installed_dpkg_database(dpkg_dir=DEFAULT_DPKG_DIR):
    status_file = Path(dpkg_dir) / 'status'
    installed = {}
    if not status_file.is_file() or status_file.is_symlink():
        return installed
    text = read_regular_bytes(status_file, LIMIT).decode('utf-8', errors='replace')
    for stanza in text.split('\n\n'):
        if not stanza.strip():
            continue
        fields = {}
        for line in stanza.splitlines():
            if line.startswith((' ', '\t')) or ':' not in line:
                continue
            key, _, val = line.partition(':')
            fields[key.strip()] = val.strip()
        name = fields.get('Package', '')
        status = fields.get('Status', '')
        version = fields.get('Version', '')
        if not name or not version:
            continue
        if status in ('install ok installed', 'hold ok installed'):
            provides = []
            for clause in parse_dependency_field(fields.get('Provides', '')):
                for prov_name, _, prov_ver in clause:
                    provides.append((prov_name, prov_ver))
            installed[name] = {
                'version': version,
                'held': status == 'hold ok installed',
                'provides': provides,
            }
    return installed


def evaluate_bundle_against_installed(packages, installed):
    """Enforce anti-downgrade, held-package protection, and dependency/conflict checks."""
    merged_versions = {name: [info['version']] for name, info in installed.items()}
    for info in installed.values():
        for prov_name, prov_ver in info['provides']:
            merged_versions.setdefault(prov_name, []).append(prov_ver)

    actions = {}
    for pkg in packages:
        name = pkg['name']
        ver = pkg['version']
        if name in installed:
            inst_ver = installed[name]['version']
            if installed[name]['held'] and not compare_dpkg_versions(ver, 'eq', inst_ver):
                fail(f'refusing to modify held package in update bundle: {name}')
            if compare_dpkg_versions(ver, 'lt', inst_ver):
                fail(f'refusing package downgrade in update bundle: {name} {ver} < installed {inst_ver}')
            actions[name] = 'reinstall' if compare_dpkg_versions(ver, 'eq', inst_ver) else 'upgrade'
        else:
            actions[name] = 'install'
        merged_versions[name] = [ver]
        for prov_name, prov_ver in pkg.get('provides', ()):
            merged_versions.setdefault(prov_name, []).append(prov_ver)

    def matches_constraint(candidate_name, rel, target_ver):
        versions = merged_versions.get(candidate_name, [])
        if not versions:
            return False
        if rel is None:
            return True
        dpkg_op = REL_TO_DPKG[rel]
        return any(
            v is not None and compare_dpkg_versions(v, dpkg_op, target_ver)
            for v in versions
        )

    for pkg in packages:
        for clause in pkg.get('depends', ()):
            if not any(matches_constraint(dep_name, rel, ver) for dep_name, rel, ver in clause):
                formatted = ' | '.join(
                    f'{d} ({r} {v})' if r else d for d, r, v in clause
                )
                fail(f'unsatisfied dependency for {pkg["name"]} {pkg["version"]}: {formatted}')
        for clause in pkg.get('conflicts', ()):
            for conf_name, rel, ver in clause:
                if conf_name != pkg['name'] and matches_constraint(conf_name, rel, ver):
                    formatted = f'{conf_name} ({rel} {ver})' if rel else conf_name
                    fail(f'package conflict for {pkg["name"]} {pkg["version"]}: {formatted}')
    return actions


def verify_bundle(bundle_dir, keyring=DEFAULT_KEYRING, dpkg_dir=None, now=None):
    bundle_dir = Path(bundle_dir)
    if not bundle_dir.is_absolute() or bundle_dir.is_symlink() or not bundle_dir.is_dir():
        fail('update bundle path must be an existing non-symlink directory')
    fingerprint, release_text = verify_gpgv(bundle_dir, keyring=keyring)
    suite, release_entries = parse_release_sha256(release_text, now=now)
    packages_rel = None
    for candidate in ('Packages', 'main/binary-amd64/Packages'):
        if candidate in release_entries and (bundle_dir / candidate).is_file():
            packages_rel = candidate
            break
    if packages_rel is None:
        fail('signed Release metadata does not authenticate a Packages index in this bundle')
    packages_path = bundle_dir / packages_rel
    expected_pkg_sha, expected_pkg_size = release_entries[packages_rel]
    packages_raw = read_regular_bytes(packages_path, LIMIT)
    actual_pkg_sha, actual_pkg_size = hashlib.sha256(packages_raw).hexdigest(), len(packages_raw)
    if actual_pkg_sha != expected_pkg_sha or actual_pkg_size != expected_pkg_size:
        fail('Packages index SHA-256 or byte size does not match signed Release metadata')
    packages = parse_packages_index(packages_raw.decode('utf-8', errors='strict'))
    expected_files = set()
    for pkg in packages:
        deb_path = bundle_dir / pkg['filename']
        for parent in deb_path.relative_to(bundle_dir).parents:
            if parent != Path('.') and (bundle_dir / parent).is_symlink():
                fail(f'symlinked directory in update bundle: {parent}')
        actual_sha, actual_size = sha256_file(deb_path)
        if actual_sha != pkg['sha256'] or actual_size != pkg['size']:
            fail(f'archive {pkg["filename"]} failed SHA-256 or size check against signed Packages')
        expected_files.add(deb_path.resolve())
    for extra in bundle_dir.rglob('*.deb'):
        if extra.is_symlink() or extra.resolve() not in expected_files:
            fail(f'unindexed .deb archive refused in update bundle: {extra.name}')
    actions = {}
    if dpkg_dir is not None:
        installed = load_installed_dpkg_database(dpkg_dir=dpkg_dir)
        actions = evaluate_bundle_against_installed(packages, installed)
    cleaned_packages = [
        {
            'name': p['name'],
            'version': p['version'],
            'architecture': p['architecture'],
            'filename': p['filename'],
            'size': p['size'],
            'sha256': p['sha256'],
        }
        | ({'action': actions[p['name']]} if p['name'] in actions else {})
        for p in packages
    ]
    return {
        'verified': True,
        'signer_fingerprint': fingerprint,
        'suite': suite,
        'package_count': len(cleaned_packages),
        'packages': cleaned_packages,
    }


def posix_dpkg_lock_active(lock_path):
    """Query POSIX record lock state (F_GETLK) used by dpkg/apt without mutating it."""
    lock_path = Path(lock_path)
    if not lock_path.is_file() or lock_path.is_symlink():
        return False, None
    fd = os.open(lock_path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        query_flock = struct.pack('hhqqI', fcntl.F_WRLCK, os.SEEK_SET, 0, 0, 0)
        reply = fcntl.fcntl(fd, fcntl.F_GETLK, query_flock)
        l_type, _, _, _, l_pid = struct.unpack('hhqqI', reply)
        if l_type != fcntl.F_UNLCK:
            return True, int(l_pid)
        return False, None
    finally:
        os.close(fd)


@contextmanager
def acquire_posix_dpkg_locks(dpkg_dir=DEFAULT_DPKG_DIR):
    """Acquire exclusive POSIX F_SETLK write locks on lock-frontend and lock in order."""
    dpkg_dir = Path(dpkg_dir)
    dpkg_dir.mkdir(parents=True, exist_ok=True)
    fds = []
    try:
        for lock_name in ('lock-frontend', 'lock'):
            lock_path = dpkg_dir / lock_name
            if lock_path.is_symlink():
                fail(f'unsafe symlinked dpkg lock file: {lock_name}')
            fd = os.open(lock_path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o640)
            fds.append(fd)
            lock_struct = struct.pack('hhqqI', fcntl.F_WRLCK, os.SEEK_SET, 0, 0, 0)
            try:
                fcntl.fcntl(fd, fcntl.F_SETLK, lock_struct)
            except OSError:
                fail(f'dpkg POSIX lock {lock_name} is held by another package manager process')
        yield
    finally:
        unlock_struct = struct.pack('hhqqI', fcntl.F_UNLCK, os.SEEK_SET, 0, 0, 0)
        for fd in reversed(fds):
            try:
                fcntl.fcntl(fd, fcntl.F_SETLK, unlock_struct)
            except OSError:
                pass
            os.close(fd)


def owned_trigger(trigger_path, staged_dir):
    trigger_path = Path(trigger_path)
    return trigger_path.is_symlink() and os.readlink(trigger_path) == str(Path(staged_dir))


def apt_command(deb_paths, dpkg_dir, staged_dir, simulate=False):
    empty_lists = Path(staged_dir)/'empty-lists'
    empty_lists.mkdir(mode=0o700, exist_ok=True)
    return ['/usr/bin/apt-get', *(['--simulate'] if simulate else []),
            '--no-download', '--no-remove', '--yes',
            '-o', 'Dir::Etc::sourcelist=/dev/null', '-o', 'Dir::Etc::sourceparts=-',
            '-o', 'Dir::State::lists=' + str(empty_lists),
            '-o', 'Dir::State::status=' + str(Path(dpkg_dir)/'status'),
            '-o', 'Dir::Cache::archives=' + str(Path(staged_dir)/'packages'),
            '-o', 'Dpkg::Options::=--force-confdef', '-o', 'Dpkg::Options::=--force-confold',
            'install', *map(str, deb_paths)]


def plan_with_apt(deb_paths, packages, dpkg_dir, staged_dir):
    """Use maintained APT's real solver; no host sources, downloads or removals."""
    result = subprocess.run(apt_command(deb_paths, dpkg_dir, staged_dir, simulate=True),
                            stdin=subprocess.DEVNULL, capture_output=True, text=True,
                            timeout=60, env={'PATH':'/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL':'C'})
    if result.returncode != 0 or len(result.stdout) > 2*1024*1024:
        fail('APT could not resolve this exact offline bundle; no update applied')
    expected = {pkg['name']: pkg['version'] for pkg in packages}
    proposed = {}
    for line in result.stdout.splitlines():
        if line.startswith('Remv '):
            fail('APT proposes package removals; update refused')
        if line.startswith('Inst '):
            match = re.match(r'Inst ([a-z0-9+.:~-]+)(?: \[[^\]]+\])? \((\S+)', line)
            if match is None:
                fail('unrecognized APT plan; update refused')
            name, version = match.groups()
            name = name.split(':', 1)[0]
            if expected.get(name) != version:
                fail('APT proposes packages outside the authenticated bundle')
            proposed[name] = version
    installed = load_installed_dpkg_database(dpkg_dir)
    require_present = [name for name, version in expected.items()
                       if installed.get(name, {}).get('version') != version]
    if any(name not in proposed for name in require_present):
        fail('APT did not propose the complete authenticated bundle')
    return proposed


def prepare_offline_transaction(
    bundle_dir,
    keyring=DEFAULT_KEYRING,
    dpkg_dir=DEFAULT_DPKG_DIR,
    state_dir=DEFAULT_STATE_DIR,
    trigger_path=DEFAULT_TRIGGER,
    now=None,
):
    """Verify a signed bundle and stage an offline transaction with a durable journal."""
    dpkg_dir = Path(dpkg_dir)
    state_dir = Path(state_dir)
    trigger_path = Path(trigger_path)
    if trigger_path.exists() or trigger_path.is_symlink():
        fail('another offline update is already pending; original preserved')
    interrupted, unconfigured = inspect_dpkg_state(dpkg_dir=dpkg_dir)
    if interrupted:
        detail = f' ({", ".join(unconfigured)})' if unconfigured else ''
        fail(f'interrupted dpkg state{detail} must be repaired before staging updates')
    with acquire_posix_dpkg_locks(dpkg_dir=dpkg_dir):
        verified = verify_bundle(bundle_dir, keyring=keyring, dpkg_dir=dpkg_dir, now=now)
        staged_dir = state_dir / 'staged'
        packages_dir = staged_dir / 'packages'
        if staged_dir.is_symlink():
            fail('unsafe symlinked update staging directory')
        if staged_dir.exists():
            fail('existing staged archives require recovery; original preserved')
        packages_dir.mkdir(parents=True, mode=0o700)
        os.chmod(state_dir, 0o700)
        os.chmod(staged_dir, 0o700)
        os.chmod(packages_dir, 0o700)
        staged_entries = []
        for pkg in verified['packages']:
            src = Path(bundle_dir) / pkg['filename']
            dst_name = pkg['name'] + '_' + pkg['sha256'] + '.deb'
            if SAFE_REL_RE.fullmatch(dst_name) is None:
                fail(f'unsafe staged archive filename: {dst_name}')
            dst = packages_dir / dst_name
            descriptor = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            with os.fdopen(descriptor, 'wb') as target, regular_stream(src) as origin:
                shutil.copyfileobj(origin, target, 1024*1024)
                target.flush()
                os.fsync(target.fileno())
            actual_sha, actual_size = sha256_file(dst)
            if actual_sha != pkg['sha256'] or actual_size != pkg['size']:
                shutil.rmtree(staged_dir, ignore_errors=True)
                fail('staged archive hash mismatch after copy')
            staged_entries.append(pkg | {'staged_filename': dst_name})
        plan_with_apt([packages_dir/p['staged_filename'] for p in staged_entries], staged_entries, dpkg_dir, staged_dir)
        recorded_at = (now or datetime.now(timezone.utc)).isoformat()
        tx_id = secrets.token_hex(16)
        manifest = {
            'version': 1,
            'transaction_id': tx_id,
            'verified': True,
            'recorded_at_utc': recorded_at,
            'signer_fingerprint': verified['signer_fingerprint'],
            'suite': verified['suite'],
            'package_count': len(staged_entries),
            'packages': staged_entries,
        }
        json_write(staged_dir / 'manifest.json', manifest, mode=0o600)
        atomic_write(staged_dir / 'ready', b'staged\n', mode=0o600)
        journal = {
            'version': 1,
            'transaction_id': tx_id,
            'status': 'staged',
            'recorded_at_utc': recorded_at,
            'suite': verified['suite'],
            'signer_fingerprint': verified['signer_fingerprint'],
            'packages': [f'{p["name"]} {p["version"]}' for p in staged_entries],
        }
        json_write(state_dir / 'journal.json', journal, mode=0o600)
        trigger_path.symlink_to(staged_dir)
        return manifest


def execute_offline_boot_transaction(
    state_dir=DEFAULT_STATE_DIR,
    trigger_path=DEFAULT_TRIGGER,
    dpkg_dir=DEFAULT_DPKG_DIR,
    runner=None,
    now=None,
):
    """Execute the systemd-offline-update transaction and record a durable journal."""
    state_dir = Path(state_dir)
    trigger_path = Path(trigger_path)
    dpkg_dir = Path(dpkg_dir)
    staged_dir = state_dir / 'staged'
    ready_path = staged_dir / 'ready'
    manifest_path = staged_dir / 'manifest.json'
    journal_path = state_dir / 'journal.json'
    timestamp = (now or datetime.now(timezone.utc)).isoformat()
    if not owned_trigger(trigger_path, staged_dir):
        return {'status': 'not-owned'}
    if runner is None and (os.geteuid() != 0 or dpkg_dir != DEFAULT_DPKG_DIR
                           or state_dir != DEFAULT_STATE_DIR or trigger_path != DEFAULT_TRIGGER):
        fail('real package application requires the fixed system paths and root service')


    # Mandatory per systemd.offline-updates(7): remove /system-update immediately
    # before package installation so a failed transaction never loops on reboot.
    if trigger_path.is_symlink() or trigger_path.is_file():
        trigger_path.unlink()
    ready_path.unlink(missing_ok=True)

    def record_failure(reason, tx_id='unknown', pkg_list=None):
        interrupted, unconfigured = inspect_dpkg_state(dpkg_dir=dpkg_dir)
        # Keep the authenticated archives available for offline rescue.
        failure_journal = {
            'version': 1,
            'transaction_id': tx_id,
            'status': 'failed',
            'recorded_at_utc': timestamp,
            'packages': pkg_list or [],
            'error': reason,
            'interrupted_dpkg': interrupted,
            'unconfigured_packages': unconfigured,
            'rescue_strategy': (
                'Boot Debian rescue media or use authenticated tty2 maintenance to inspect '
                '/var/lib/wros-update/journal.json and run dpkg --configure -a; restore '
                'manuscripts from encrypted Restic backup if needed.'
            ),
        }
        json_write(journal_path, failure_journal, mode=0o600)
        fail(reason)

    def reject(reason, **context):
        fail(reason)

    tx_id, pkg_labels = 'unknown', []
    try:
        if not manifest_path.is_file() or manifest_path.is_symlink():
            reject('missing or symlinked staged update manifest')
        manifest = json.loads(read_regular_bytes(manifest_path, 262144).decode('utf-8'))
        tx_id = str(manifest.get('transaction_id', 'unknown'))
        packages = manifest.get('packages', [])
        if manifest.get('verified') is not True or not packages:
            reject('invalid staged update manifest', tx_id=tx_id)
        pkg_labels = [f'{p["name"]} {p["version"]}' for p in packages]

        interrupted_before, unconfigured_before = inspect_dpkg_state(dpkg_dir=dpkg_dir)
        if interrupted_before:
            reject(
                f'dpkg already interrupted before offline update ({", ".join(unconfigured_before)})',
                tx_id=tx_id,
                pkg_list=pkg_labels,
            )
        for lock_name in ('lock-frontend', 'lock'):
            locked, holder = posix_dpkg_lock_active(dpkg_dir / lock_name)
            if locked:
                reject(
                    f'dpkg POSIX lock {lock_name} is held by PID {holder}',
                    tx_id=tx_id,
                    pkg_list=pkg_labels,
                )

        deb_paths = []
        for pkg in packages:
            staged_name = pkg.get('staged_filename', '')
            if SAFE_REL_RE.fullmatch(staged_name) is None:
                reject(f'unsafe staged filename: {staged_name!r}', tx_id=tx_id, pkg_list=pkg_labels)
            deb_file = staged_dir / 'packages' / staged_name
            if not deb_file.is_file() or deb_file.is_symlink():
                reject(f'missing staged archive: {staged_name}', tx_id=tx_id, pkg_list=pkg_labels)
            actual_sha, actual_size = sha256_file(deb_file)
            if actual_sha != pkg.get('sha256') or actual_size != pkg.get('size'):
                reject(f'staged archive {staged_name} failed SHA-256 verification', tx_id=tx_id, pkg_list=pkg_labels)
            deb_paths.append(str(deb_file))

        json_write(
            journal_path,
            {
                'version': 1,
                'transaction_id': tx_id,
                'status': 'applying',
                'recorded_at_utc': timestamp,
                'packages': pkg_labels,
            },
            mode=0o600,
        )
        apt_cmd = apt_command(deb_paths, dpkg_dir, staged_dir)
        run_cmd = runner or (
            lambda cmd: subprocess.run(
                cmd,
                stdin=subprocess.DEVNULL,
                capture_output=True,
                text=True,
                timeout=1800,
                env={
                    'PATH': '/usr/sbin:/usr/bin:/sbin:/bin',
                    'LC_ALL': 'C',
                    'DEBIAN_FRONTEND': 'noninteractive',
                },
            )
        )
        try:
            plan_with_apt(deb_paths, packages, dpkg_dir, staged_dir)
            res = run_cmd(apt_cmd)
            interrupted_after, unconfigured_after = inspect_dpkg_state(dpkg_dir=dpkg_dir)
            if res.returncode != 0 or interrupted_after:
                reject('offline apt-get transaction failed; authenticated archives retained for rescue', tx_id=tx_id, pkg_list=pkg_labels)
            installed_after = load_installed_dpkg_database(dpkg_dir)
            if any(installed_after.get(pkg['name'], {}).get('version') != pkg['version'] for pkg in packages):
                reject('offline apt-get did not install the reviewed package versions', tx_id=tx_id, pkg_list=pkg_labels)
        except Exception:
            reject('offline apt-get transaction failed or was interrupted; authenticated archives retained for rescue', tx_id=tx_id, pkg_list=pkg_labels)

        shutil.rmtree(staged_dir, ignore_errors=True)
        completed_journal = {
            'version': 1,
            'transaction_id': tx_id,
            'status': 'applied',
            'recorded_at_utc': timestamp,
            'packages': pkg_labels,
            'interrupted_dpkg': False,
            'unconfigured_packages': [],
        }
        json_write(journal_path, completed_journal, mode=0o600)
        return completed_journal
    except Exception:
        record_failure('offline apt-get transaction failed or was interrupted; authenticated archives retained for rescue', tx_id=tx_id, pkg_list=pkg_labels)


def decode_mountinfo_path(token):
    return re.sub(r'\\([0-7]{3})', lambda m: chr(int(m.group(1), 8)), token)


def parse_mountinfo(mountinfo_text):
    mounts = {}
    for line in mountinfo_text.splitlines():
        if ' - ' not in line:
            continue
        left, _, right = line.partition(' - ')
        left_parts = left.split()
        right_parts = right.split()
        if len(left_parts) < 5 or len(right_parts) < 2:
            continue
        mountpoint = decode_mountinfo_path(left_parts[4])
        fstype = right_parts[0]
        source = decode_mountinfo_path(right_parts[1])
        mounts[mountpoint] = (fstype, source)
    return mounts


def inspect_dpkg_state(dpkg_dir=DEFAULT_DPKG_DIR):
    dpkg_dir = Path(dpkg_dir)
    status_file = dpkg_dir / 'status'
    updates_dir = dpkg_dir / 'updates'
    unconfigured = []
    interrupted = False
    if updates_dir.is_dir() and not updates_dir.is_symlink():
        for entry in sorted(updates_dir.iterdir()):
            if entry.name.isdigit() and entry.is_file() and entry.stat().st_size > 0:
                interrupted = True
    if status_file.is_file() and not status_file.is_symlink():
        text = read_regular_bytes(status_file, LIMIT).decode('utf-8', errors='replace')
        for stanza in text.split('\n\n'):
            pkg_name = None
            pkg_status = None
            for line in stanza.splitlines():
                if line.startswith('Package:'):
                    pkg_name = line.partition(':')[2].strip()
                elif line.startswith('Status:'):
                    pkg_status = line.partition(':')[2].strip()
            if pkg_name and pkg_status:
                if pkg_status not in (
                    'install ok installed',
                    'deinstall ok config-files',
                    'purge ok not-installed',
                    'hold ok installed',
                ):
                    interrupted = True
                    if pkg_name not in unconfigured:
                        unconfigured.append(pkg_name)
    return interrupted, sorted(unconfigured)


def inspect_recovery(
    mountinfo_text=None,
    dpkg_dir=DEFAULT_DPKG_DIR,
    state_dir=DEFAULT_STATE_DIR,
    trigger_path=DEFAULT_TRIGGER,
    root_dir=Path('/'),
):
    if mountinfo_text is None:
        mountinfo_text = Path('/proc/self/mountinfo').read_text(encoding='utf-8', errors='replace')
    mounts = parse_mountinfo(mountinfo_text)
    root_fs, root_dev = mounts.get('/', ('unknown', 'unknown'))
    separate_home = '/home' in mounts
    rollback_capable = False  # A directory/layout alone is no tested bootable rollback protocol.
    if root_fs == 'ext4':
        strategy = (
            'Root filesystem is ext4: automatic filesystem snapshot rollback is not available '
            '(installing Snapper on ext4 does not provide rollback). Create an encrypted Restic '
            'project backup before applying updates and use Debian live/rescue media for system recovery.'
        )
    else:
        strategy = (
            f'Root filesystem is {root_fs}: automatic filesystem rollback is not qualified on this layout. '
            'Create an encrypted Restic project backup before applying updates.'
        )
    interrupted_dpkg, unconfigured = inspect_dpkg_state(dpkg_dir=dpkg_dir)
    state_dir = Path(state_dir)
    trigger_path = Path(trigger_path)
    manifest_path = state_dir / 'staged/manifest.json'
    journal_path = state_dir / 'journal.json'
    staged_update = False
    staged_packages = []
    if manifest_path.is_file() and not manifest_path.is_symlink():
        try:
            manifest = json.loads(read_regular_bytes(manifest_path, 262144).decode('utf-8'))
            if manifest.get('verified') is True and isinstance(manifest.get('packages'), list):
                staged_packages = [
                    f'{p["name"]} {p["version"]}'
                    for p in manifest['packages']
                    if isinstance(p, dict) and 'name' in p and 'version' in p
                ]
                staged_update = bool(
                    staged_packages
                    and (trigger_path.is_symlink() or trigger_path.exists() or (state_dir / 'staged/ready').is_file())
                )
        except Exception:
            staged_update = False
            staged_packages = []
    parts = [
        f'Root filesystem: {root_fs} '
        + ('(btrfs snapshot rollback available)' if rollback_capable else '(no automatic filesystem rollback)'),
        f'dpkg: {"interrupted (" + ", ".join(unconfigured) + ")" if interrupted_dpkg else "clean"}',
        f'staged offline update: {len(staged_packages)} package(s)' if staged_update else 'no offline update staged',
    ]
    if journal_path.is_file() and not journal_path.is_symlink():
        try:
            journal = json.loads(read_regular_bytes(journal_path, 65536).decode('utf-8'))
            j_status = journal.get('status')
            if j_status in ('applied', 'failed', 'applying'):
                detail = f' ({journal["error"]})' if j_status == 'failed' and journal.get('error') else ''
                parts.append(f'last offline update: {j_status}{detail}')
        except Exception:
            pass
    return {
        'root_filesystem': root_fs,
        'root_device': root_dev,
        'separate_home': separate_home,
        'rollback_capable': rollback_capable,
        'rollback_strategy': strategy,
        'interrupted_dpkg': interrupted_dpkg,
        'unconfigured_packages': unconfigured,
        'staged_update': staged_update,
        'staged_packages': staged_packages,
        'status': ' · '.join(parts) + '.',
    }


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv == ['recovery-status']:
        result = inspect_recovery()
    elif len(argv) == 2 and argv[0] == 'verify-bundle':
        verified = verify_bundle(Path(argv[1]))
        result = {
            'status': 'verified',
            'message': (
                f"Signature and contents verified for {verified['package_count']} package(s). "
                'Inspection only: repository freshness, dependency resolution and downgrade '
                'policy are unchecked. Update installation and automatic rollback are unavailable.'
            ),
        }
    elif argv == ['run-offline-boot']:
        if (
            os.geteuid() != 0
            or os.getppid() != 1
            or 'PKEXEC_UID' in os.environ
            or os.environ.get('WROS_SYSTEMD_OFFLINE_UPDATE') != '1'
        ):
            fail('Update installation and package repair are unavailable; no system changes were made.')
        ours = owned_trigger(DEFAULT_TRIGGER, DEFAULT_STATE_DIR/'staged')
        try:
            result = execute_offline_boot_transaction()
        finally:
            if ours and not owned_trigger(DEFAULT_TRIGGER, DEFAULT_STATE_DIR/'staged'):
                subprocess.run(['/usr/bin/systemctl', '--no-block', 'reboot'],
                               stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, timeout=15, check=True,
                               env={'PATH':'/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL':'C'})
    else:
        fail('Update installation and package repair are unavailable; no system changes were made.')
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print(str(exc), file=sys.stderr)
        raise SystemExit(1) from None
