#!/usr/bin/python3 -I
"""pkexec launcher (org.wros.update.fetch): download the newest signed WrOS update.

Usage: wros-update-fetch.  The update URL is fixed in the engine; the bundle lands in
/var/cache/wros-update/online/<id> only after every archive and signature verifies.
"""
import importlib.machinery
import importlib.util
import json
import os
import sys

ENGINE = '/usr/lib/wros-update/engine.py'
VERB = 'fetch'
SAFE_PATH = '/usr/sbin:/usr/bin:/sbin:/bin'


def load_engine(path=None):
    loader = importlib.machinery.SourceFileLoader('wros_update_engine', path or ENGINE)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def main(argv=None, environ=None, euid=None, engine_path=None, **seams):
    argv = sys.argv[1:] if argv is None else argv
    source = os.environ if environ is None else environ
    pkexec_uid = source.get('PKEXEC_UID')
    if environ is None:
        os.environ.clear()
        os.environ.update({'PATH': SAFE_PATH, 'LC_ALL': 'C'})
    engine = load_engine(engine_path)
    result = engine.launcher_main(VERB, argv, pkexec_uid, euid=euid, **seams)
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(str(exc), file=sys.stderr)
        raise SystemExit(1) from None
