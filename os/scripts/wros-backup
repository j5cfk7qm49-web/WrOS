#!/usr/bin/python3 -I
"""Unprivileged native backup adapter. Restic owns encryption and repository IO.

One JSON request on stdin, one bounded JSON response. No shell, polkit, scheduled
network, mounted manuscripts, or restore over an existing book. The only deletion is
retention of automatic snapshots (retention_forget); manual ones are never pruned.
"""
import configparser
import ctypes
from datetime import datetime, timedelta, timezone
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import threading

MAX_FILES = 100_000
MAX_BYTES = 5 * 1024**3
MAX_JSON = 2 * 1024**2
MANIFEST = '.wros-backup-manifest.json'
# Phone linking (os/scripts/wros-link.py): its module, and WrOS's own Google clients, which a
# release build puts into the package from a file kept out of the repository.
LINK_MODULE = '/usr/lib/wros-backup/link.py'
GOOGLE_CLIENTS = '/usr/share/wros/google-client.json'
# The writer's settings, beside the book in the same snapshot: grimoire's own files and the
# keyboard layout and timezone. Never the recovery key, Google tokens or Wi-Fi passwords.
PROFILE = '.wros-profile'
PROFILE_FILE_LIMIT = 1024 * 1024
PROFILE_TOTAL_LIMIT = 4 * 1024 * 1024
TAG = 'wros-project-v1'


def now():
    return datetime.now(timezone.utc).isoformat()


# An automatic backup reads back only the files changed since the last checked one; a
# complete restore runs at least this often, and whenever more files than the limit changed.
FULL_CHECK_AGE = timedelta(days=7)
CHANGED_CHECK_LIMIT = 200

KEEP_EVERY = timedelta(days=7)
KEEP_DAILY = timedelta(days=90)


def iso_week(moment):
    return tuple(moment.isocalendar())[:2]


def restic_time(text):
    """restic's RFC 3339 times carry nanoseconds; Python reads at most microseconds."""
    return datetime.fromisoformat(re.sub(r'(\.\d{6})\d+', r'\1', text))


def retention_forget(rows, now):
    """Automatic snapshots to forget, per book: keep every one from the last 7 days, the newest
    of each day to 90 days, and the newest of each ISO week after that. Agreed with the writer
    on 2026-11-04. Snapshots without the auto tag (manual or named) are never returned."""
    books = {}
    for row in rows:
        tags = row.get('tags') or []
        if 'auto' in tags:
            book = next((t for t in tags if t.startswith('project:')), '')
            books.setdefault(book, []).append((restic_time(row['time']), row['id']))
    forget = []
    for snapshots in books.values():
        kept = set()
        for moment, identifier in sorted(snapshots, reverse=True):
            age = now - moment
            if age <= KEEP_EVERY:
                continue
            bucket = ('day', moment.date()) if age <= KEEP_DAILY else ('week', iso_week(moment))
            if bucket in kept:
                forget.append(identifier)
            else:
                kept.add(bucket)
    return forget


def require(condition, message):
    if not condition:
        raise ValueError(message)


def private_file(path):
    info = path.lstat()
    require(stat.S_ISREG(info.st_mode) and info.st_uid == os.geteuid()
            and not info.st_mode & 0o077, 'Recovery/configuration file must be private and owned by you.')
    return path


def read_json(path):
    private_file(path)
    require(path.stat().st_size <= MAX_JSON, 'Configuration is too large; original preserved.')
    return json.loads(path.read_text(encoding='utf-8'))


def write_private(path, contents, exclusive=False):
    flags = os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW
    flags |= os.O_EXCL if exclusive else os.O_TRUNC
    with os.fdopen(os.open(path, flags, 0o600), 'wb') as stream:
        stream.write(contents)
        stream.flush()
        os.fsync(stream.fileno())


def atomic_private(path, contents):
    temp = path.with_name('.' + path.name + '-' + secrets.token_hex(8))
    try:
        write_private(temp, contents, exclusive=True)
        os.replace(temp, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        temp.unlink(missing_ok=True)


def run(program, arguments, env, cwd=None):
    # Raw upstream output can contain filenames or OAuth responses. It never
    # enters native notices, logs, argv diagnostics, or the response protocol.
    with tempfile.TemporaryFile() as output:
        result = subprocess.run([program, *arguments], env=env, cwd=cwd,
                                stdin=subprocess.DEVNULL, stdout=output,
                                stderr=subprocess.DEVNULL, timeout=1800)
        require(result.returncode == 0,
                f'{Path(program).name} did not complete. Check connectivity, recovery key, free space and repository locks; retry explicitly.')
        require(output.tell() <= MAX_JSON, 'Tool response exceeded the supported size; no verification claimed.')
        output.seek(0)
        return output.read()


def progress(phase, percent=None, offer=None):
    """One line on stderr for the native app: a fixed step name and, when
    restic reports it, a fraction. Never a file name or tool output. Phone
    linking adds the offer on screen: the QR code, its link and the code."""
    row = {'phase': phase}
    if isinstance(percent, (int, float)) and not isinstance(percent, bool):
        row['percent'] = round(min(max(float(percent), 0.0), 1.0), 4)
    if offer is not None:
        row['offer'] = {'link': offer['link'], 'code': offer['code'], 'qr': offer['qr']}
    sys.stderr.write(json.dumps({'progress': row}) + '\n')
    sys.stderr.flush()


def run_reporting(program, arguments, env, cwd, phase):
    """As run(), reporting restic's status lines as progress. They are never
    kept, so a long operation cannot reach the response size limit."""
    progress(phase)
    kept, size = [], 0
    process = subprocess.Popen([program, *arguments], env=dict(env, RESTIC_PROGRESS_FPS='0.5'), cwd=cwd,
                               stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    timer = threading.Timer(1800, process.kill)
    timer.start()
    try:
        for line in process.stdout:
            try:
                row = json.loads(line)
            except ValueError:
                row = None
            if isinstance(row, dict) and row.get('message_type') == 'status':
                progress(phase, row.get('percent_done'))
                continue
            size += len(line)
            require(size <= MAX_JSON, 'Tool response exceeded the supported size; no verification claimed.')
            kept.append(line)
        returncode = process.wait()
    finally:
        timer.cancel()
        if process.poll() is None:
            process.kill()
            process.wait()
        process.stdout.close()
    require(returncode == 0,
            f'{Path(program).name} did not complete. Check connectivity, recovery key, free space and repository locks; retry explicitly.')
    return b''.join(kept)


def classify_rclone_failure(arguments, env):
    """Run rclone and classify failure into auth-revoked vs offline without leaking stderr."""
    with tempfile.TemporaryFile() as output, tempfile.TemporaryFile() as err_out:
        result = subprocess.run(['/usr/bin/rclone', *arguments], env=env,
                                stdin=subprocess.DEVNULL, stdout=output,
                                stderr=err_out, timeout=1800)
        if result.returncode == 0:
            require(output.tell() <= MAX_JSON, 'Tool response exceeded the supported size; no verification claimed.')
            output.seek(0)
            return True, output.read(), ''
        err_out.seek(0)
        return False, b'', rclone_failure_kind(err_out.read(65536).decode('utf-8', errors='replace'))


def rclone_failure_kind(err_text):
    """Which problem rclone's private error output describes; the text itself is never shown."""
    err_text = err_text.lower()
    kinds = (
        ('reauthorization-required', ('invalid_grant', 'token has been expired or revoked', 'unauthorized',
                                      'invalid_client', '401 unauthorized')),
        # A clock far off makes every certificate look expired or not yet valid.
        ('clock', ('certificate has expired or is not yet valid', 'certificate is not yet valid',
                   'certificate has expired')),
        # Google throttling requests (the shared rclone sign-in hits its per-minute quota often).
        ('rate-limited', ('ratelimitexceeded', 'rate_limit_exceeded', 'rate limit exceeded', 'quota exceeded')),
        ('offline', ('no such host', 'network is unreachable', 'connection refused', 'i/o timeout',
                     'temporary failure in name resolution', 'tls handshake timeout',
                     'context deadline exceeded', 'no route to host', 'connection reset')),
    )
    for kind, needles in kinds:
        if any(needle in err_text for needle in needles):
            return kind
    return 'unknown'


RATE_LIMITED = ('Google is limiting requests right now; try again in a few minutes. A Drive linked with '
                'your phone uses WrOS\'s own Google access, which Google slows down far less often.')


def clock_message():
    return (f"This computer's clock says {datetime.now().astimezone().strftime('%Y-%m-%d %H:%M')}, so secure connections to Google fail. "
            'Set the date and time in Settings > System > Date and time, then retry.')


def google_connect_failure(kind):
    return {
        'reauthorization-required': 'Google refused this authorization: it expired, was revoked or was made '
                                    'with your own client_id. Run rclone authorize drive again and use the new response.',
        'clock': clock_message(),
        'offline': 'WrOS could not reach Google. Check Wi-Fi in Settings > System > Wi-Fi and networking, then retry.',
        'rate-limited': RATE_LIMITED,
    }.get(kind, 'rclone could not connect to Google Drive for an unrecognized reason. '
                'Existing credentials are unchanged; retry, or authorize again.')


def inventory_digest(inv):
    return hashlib.sha256(json.dumps(inv, sort_keys=True).encode('utf-8')).hexdigest()


def safe_new_path(value):
    require(isinstance(value, str) and len(value) <= 4096 and not any(ord(c) < 32 for c in value), 'Invalid destination path.')
    path = Path(value).expanduser()
    require(path.is_absolute() and path.name not in ('', '.', '..'), 'Choose an absolute path with a new folder/file name.')
    require(not path.exists() and not path.is_symlink(), 'Destination already exists; choose a NEW name. Nothing overwritten.')
    return path.parent.resolve(strict=True) / path.name


def publish_directory(source, target):
    # rename() can replace an existing empty directory. Use the kernel's
    # no-replacement operation, including if another process creates the target.
    libc = ctypes.CDLL(None, use_errno=True)
    result = libc.renameat2(-100, os.fsencode(source), -100, os.fsencode(target), 1)
    if result:
        raise OSError(ctypes.get_errno(), 'Restore destination could not be published; existing paths preserved.')
    fd = os.open(target.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def inventory(root, copy_to=None):
    files, directories, total = {}, [], 0
    def visit(directory, prefix='', depth=0):
        nonlocal total
        require(depth <= 64, 'Project nesting exceeds the supported backup depth.')
        for name in sorted(os.listdir(directory)):
            relative = prefix + name
            require(len(files) + len(directories) < MAX_FILES, 'Project exceeds 100,000 backup entries.')
            info = os.stat(name, dir_fd=directory, follow_symlinks=False)
            require(not stat.S_ISLNK(info.st_mode), 'Project contains a symbolic link; resolve it before backup. No partial backup is verified.')
            if stat.S_ISDIR(info.st_mode):
                directories.append(relative)
                if copy_to:
                    (copy_to/relative).mkdir(mode=0o700)
                child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
                try:
                    opened = os.fstat(child)
                    require((opened.st_dev, opened.st_ino) == (info.st_dev, info.st_ino), 'Project changed while reading; retry after saving.')
                    visit(child, relative + '/', depth + 1)
                finally:
                    os.close(child)
            else:
                require(stat.S_ISREG(info.st_mode), 'Project contains a special file; no backup is verified.')
                total += info.st_size
                require(total <= MAX_BYTES, 'Project exceeds the supported 5 GiB backup size.')
                digest, size = hashlib.sha256(), 0
                source = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
                with os.fdopen(source, 'rb') as stream:
                    opened = os.fstat(stream.fileno())
                    require(stat.S_ISREG(opened.st_mode) and (opened.st_dev, opened.st_ino) == (info.st_dev, info.st_ino),
                            'Project changed while reading; retry after saving.')
                    target = (copy_to/relative).open('xb') if copy_to else None
                    try:
                        while chunk := stream.read(1024 * 1024):
                            size += len(chunk)
                            require(size <= info.st_size, 'Project changed while reading; retry after saving.')
                            digest.update(chunk)
                            if target:
                                target.write(chunk)
                        if target:
                            target.flush()
                            os.fsync(target.fileno())
                    finally:
                        if target:
                            target.close()
                    after = os.fstat(stream.fileno())
                    require(size == info.st_size and (info.st_mtime_ns, info.st_ctime_ns) == (after.st_mtime_ns, after.st_ctime_ns),
                            'Project changed while reading; retry after saving.')
                files[relative] = {'bytes': size, 'sha256': digest.hexdigest()}
    source = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        visit(source)
    finally:
        os.close(source)
    return {'files': files, 'directories': directories, 'bytes': total}


def load_link():
    import importlib.machinery
    import importlib.util
    path = LINK_MODULE if Path(LINK_MODULE).is_file() else str(Path(__file__).with_name('wros-link.py'))
    loader = importlib.machinery.SourceFileLoader('wros_link', path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def revoke_google(refresh_token):
    """End the grant at Google. True when Google confirmed it."""
    import urllib.error
    import urllib.parse
    import urllib.request
    request = urllib.request.Request('https://oauth2.googleapis.com/revoke',
                                     data=urllib.parse.urlencode({'token': refresh_token}).encode(), method='POST')
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            return response.status == 200
    except (urllib.error.URLError, OSError, ValueError):
        return False


class Service:
    def __init__(self, state):
        self.state = state
        require(state.is_absolute(), 'Backup state must be an absolute private directory.')
        require(not state.is_symlink(), 'Backup state directory cannot be a symbolic link.')
        state.mkdir(parents=True, exist_ok=True, mode=0o700)
        info = state.stat()
        require(info.st_uid == os.geteuid() and not info.st_mode & 0o077, 'Backup state directory must be private and owned by you.')
        self.config = state/'repository.json'
        self.google = state/'rclone.conf'
        self.account = state/'google-account.json'
        self.queue_path = state/'queue.json'
        # book folder -> its latest verified snapshot; restic only knows the staging copy.
        self.latest_path = state/'latest.json'
        self.drive_browser_path = state/'drive-browser.json'
        self.drive_cache = state/'drive-cache'
        self.clients_path = Path(GOOGLE_CLIENTS)
        self.profile_config = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home()/'.config')))/'grimoire'
        self.keyboard_file = Path('/etc/wros/keyboard.json')
        self.timezone_file = Path('/etc/timezone')
        self.env = {key: value for key, value in os.environ.items()
                    if not key.startswith(('RESTIC_', 'RCLONE_'))}
        self.env.update(PATH='/usr/bin:/bin', RCLONE_CONFIG=str(self.google),
                        RESTIC_CACHE_DIR=str(state/'cache'), GOMAXPROCS='2')
        self.current = None
        if self.config.exists() or self.config.is_symlink():
            value = read_json(self.config)
            require(set(value) == {'version', 'repository', 'key', 'verified'} and value['version'] == 1
                    and isinstance(value['verified'], dict), 'Unknown backup configuration; original preserved.')
            self.current = value
        self.google_meta = None
        if self.account.exists() or self.account.is_symlink():
            meta = read_json(self.account)
            require(isinstance(meta, dict) and meta.get('version') == 1
                    and set(meta) <= {'version', 'connected_at', 'verified_at', 'token_expiry', 'state', 'last_error'}
                    and meta.get('state') in ('connected', 'reauthorization-required', 'offline'),
                    'Unknown Google account metadata; original preserved.')
            self.google_meta = meta
        self.queue = []
        if self.queue_path.exists() or self.queue_path.is_symlink():
            qdata = read_json(self.queue_path)
            require(isinstance(qdata, dict) and qdata.get('version') == 1
                    and set(qdata) == {'version', 'items'}
                    and isinstance(qdata.get('items'), list) and len(qdata['items']) <= 64,
                    'Unknown backup queue metadata; original preserved.')
            for item in qdata['items']:
                require(isinstance(item, dict)
                        and set(item) == {'id', 'project', 'label', 'queued_at', 'attempts', 'last_error', 'inventory_sha256'}
                        and isinstance(item['id'], str) and re.fullmatch('[a-f0-9]{16}', item['id'])
                        and isinstance(item['project'], str) and item['project'].startswith('/')
                        and isinstance(item['label'], str)
                        and isinstance(item['queued_at'], str)
                        and isinstance(item['attempts'], int) and item['attempts'] >= 0
                        and isinstance(item['last_error'], str)
                        and isinstance(item['inventory_sha256'], str) and re.fullmatch('[a-f0-9]{64}', item['inventory_sha256']),
                        'Invalid backup queue entry; original preserved.')
            self.queue = qdata['items']
        self.drive_folder = 'drive:WrOS-Library'
        self.drive_entries = []
        if self.drive_browser_path.exists() or self.drive_browser_path.is_symlink():
            bdata = read_json(self.drive_browser_path)
            require(isinstance(bdata, dict) and bdata.get('version') == 1
                    and set(bdata) <= {'version', 'folder', 'entries'},
                    'Unknown Drive browser metadata; original preserved.')
            self.drive_folder = str(bdata.get('folder', 'drive:WrOS-Library'))
            self.drive_entries = list(bdata.get('entries', []))

    def save(self):
        atomic_private(self.config, (json.dumps(self.current) + '\n').encode())

    def save_account(self):
        if self.google_meta is None:
            if self.account.exists() and not self.account.is_symlink():
                self.account.unlink()
        else:
            atomic_private(self.account, (json.dumps(self.google_meta) + '\n').encode())

    def save_queue(self):
        atomic_private(self.queue_path, (json.dumps({'version': 1, 'items': self.queue}) + '\n').encode())

    def save_drive_browser(self):
        atomic_private(self.drive_browser_path, (json.dumps({
            'version': 1,
            'folder': self.drive_folder,
            'entries': self.drive_entries,
        }) + '\n').encode())

    def repository(self, descriptor):
        require(isinstance(descriptor, str) and len(descriptor) <= 4096
                and not any(ord(c) < 32 for c in descriptor), 'Invalid backup destination.')
        if descriptor.startswith('drive:'):
            folder = descriptor[6:]
            require(folder and not folder.startswith('/') and all(p not in ('', '.', '..') for p in folder.split('/')),
                    'Choose a relative Google Drive folder, for example drive:WrOS-Backups.')
            private_file(self.google)
            return 'rclone:wros-google:' + folder
        path = Path(descriptor).expanduser()
        require(path.is_absolute(), 'Choose an absolute local folder or drive:WrOS-Backups.')
        if path.exists():
            require(path.is_dir() and not path.is_symlink(), 'Repository must be a regular directory.')
            return str(path.resolve(strict=True))
        return str(safe_new_path(str(path)))

    def restic(self, arguments, cwd=None, config=None, phase=None):
        config = config or self.current
        require(config is not None, 'Set up or connect a backup repository first.')
        private_file(Path(config['key']))
        repository = self.repository(config['repository'])
        common = ['--repo', repository, '--password-file', config['key'], '--json']
        if phase:
            return run_reporting('/usr/bin/restic', [*common, *arguments], self.env, cwd, phase)
        return run('/usr/bin/restic', [*common, '--quiet', *arguments], self.env, cwd)

    def configure(self, repository, key=None):
        self.repository(repository)  # Refuse unsupported endpoints before IO.
        key_path = self.state/('recovery-' + secrets.token_hex(16) + '.key')
        if key:
            source = Path(key).expanduser()
            require(not source.is_symlink() and source.is_file() and source.stat().st_size <= 4096,
                    'Select a regular recovery key file (at most 4096 bytes).')
            secret = source.read_bytes()
            require(16 <= len(secret.strip()) <= 4096 and b'\0' not in secret, 'Recovery key file is invalid.')
        else:
            if not repository.startswith('drive:'):
                safe_new_path(repository)
            secret = (secrets.token_hex(32) + '\n').encode()
        write_private(key_path, secret, exclusive=True)
        config = {'version': 1, 'repository': repository, 'key': str(key_path), 'verified': {}}
        # On failure keep the generated key: a remote init might have succeeded
        # before a connection failed. Never silently abandon its recovery key.
        try:
            self.restic(['snapshots'] if key else ['init'], config=config)
        except Exception:
            raise ValueError('Repository setup incomplete. Recovery key retained at ' + str(key_path) + '; reconnect using that file after correcting the destination or connection.') from None
        self.current = config
        self.save()
        return self.status('Repository connected. Export your recovery key to a separate safe device before relying on this backup.')

    def snapshots(self, queue_id=None):
        if not self.current:
            return []
        tags = TAG + (',queue:' + queue_id if queue_id else '')
        rows = json.loads(self.restic(['snapshots', '--tag', tags])) or []
        require(isinstance(rows, list) and len(rows) <= 1000, 'Repository exceeds 1,000 supported snapshots; use Restic maintenance tools.')
        result = []
        for row in rows:
            identifier = row.get('id', '')
            require(re.fullmatch('[a-f0-9]{64}', identifier), 'Invalid snapshot identity; refresh refused.')
            paths = row.get('paths', [])
            require(len(paths) == 1 and isinstance(paths[0], str) and paths[0].startswith('/'), 'Unsupported snapshot paths.')
            result.append({'id': identifier, 'time': row['time'], 'path': paths[0],
                           'project': next((t[8:] for t in row.get('tags', []) if t.startswith('project:')), 'Book'),
                           'has_profile': 'profile' in row.get('tags', []),
                           'restore_checked_at': self.current['verified'].get(identifier, '')})
        return sorted(result, key=lambda item: item['time'], reverse=True)

    def status(self, notice='', refresh=True):
        google_connected = (self.google.is_file() and not self.google.is_symlink()
                            and not (self.google.lstat().st_mode & 0o077))
        if not google_connected:
            google_state = 'not-connected'
            google_verified_at = ''
            google_expiry = ''
        elif self.google_meta:
            google_state = self.google_meta.get('state', 'connected')
            google_verified_at = self.google_meta.get('verified_at', '')
            google_expiry = self.google_meta.get('token_expiry', '')
        else:
            google_state = 'connected'
            google_verified_at = ''
            google_expiry = ''
        return {'configured': self.current is not None,
                'repository': self.current['repository'] if self.current else '',
                'recovery_key': self.current['key'] if self.current else '',
                'google_connected': google_connected,
                'phone_linking': self.google_clients() is not None,
                'google_shared_client': google_connected and self.shared_google_client(),
                'google_state': google_state,
                'google_verified_at': google_verified_at,
                'google_expiry': google_expiry,
                'queued_backups': list(self.queue),
                'drive_folder': self.drive_folder,
                'drive_entries': list(self.drive_entries),
                'snapshots': self.named_snapshots() if refresh else self.latest_snapshots(), 'notice': notice}

    def named_snapshots(self):
        """The refreshed list as shown: a snapshot this computer recorded names its book's folder
        (restic itself only knows the staging copy; restore keeps using that)."""
        folders = {entry['id']: root for root, entry in self.latest().items()}
        return [row | {'path': folders.get(row['id'], row['path'])} for row in self.snapshots()]

    def latest(self):
        """{book folder: {'id', 'time', 'project'}}; an unreadable record is treated as empty."""
        try:
            private_file(self.latest_path)
            value = json.loads(self.latest_path.read_text(encoding='utf-8'))
        except (OSError, ValueError):
            return {}
        if not isinstance(value, dict):
            return {}
        return {root: entry for root, entry in value.items()
                if isinstance(entry, dict) and {'id', 'time', 'project'} <= set(entry)}

    def record_latest(self, root, snapshot):
        record = self.latest()
        record[str(root)] = {'id': snapshot['id'], 'time': snapshot['time'], 'project': root.name}
        atomic_private(self.latest_path, json.dumps(record, sort_keys=True).encode())

    def latest_snapshots(self):
        """Each book's latest verified snapshot under its real folder, without contacting the repository."""
        if not self.current:
            return []
        verified = self.current['verified']
        return sorted(({'id': entry['id'], 'time': entry['time'], 'path': root, 'project': entry['project'],
                        'restore_checked_at': verified[entry['id']]}
                       for root, entry in self.latest().items() if entry['id'] in verified),
                      key=lambda item: item['time'], reverse=True)

    def restore_into(self, snapshot, target, phase='Checking the snapshot by restoring it'):
        self.restic(['restore', snapshot['id'] + ':' + snapshot['path'], '--target', str(target), '--verify', '--overwrite', 'never'],
                    phase=phase)
        manifest = target/MANIFEST
        require(manifest.is_file() and not manifest.is_symlink() and manifest.stat().st_size <= 32 * 1024**2,
                'Snapshot manifest missing or unsafe; restore is not verified.')
        expected = json.loads(manifest.read_text(encoding='utf-8'))
        require(isinstance(expected, dict) and expected.get('version') == 1 and 'inventory' in expected,
                'Unsupported backup manifest; restore is not verified.')
        manifest.unlink()
        profile = None
        if 'profile' in expected:
            require((target/PROFILE).is_dir() and not (target/PROFILE).is_symlink(),
                    'The settings saved with this backup are missing; restore is not verified.')
            profile = target.parent/('.wros-profile-' + secrets.token_hex(6))
            os.rename(target/PROFILE, profile)
            require(inventory(profile) == expected['profile'],
                    'The settings saved with this backup differ; restore is not verified.')
        progress('Comparing every restored file')
        actual = inventory(target)
        require(actual == expected['inventory'], 'Restored file names, bytes or SHA-256 hashes differ; restore is not verified.')
        return actual, profile

    def check_path(self, root):
        return self.state/'checked'/(hashlib.sha256(str(root).encode()).hexdigest() + '.json')

    def last_check(self, root):
        """The book's last checked snapshot, while it is in this repository and its last
        complete restore is under FULL_CHECK_AGE old; otherwise None."""
        try:
            value = read_json(self.check_path(root))
            full_at = datetime.fromisoformat(value['full_at'])
        except (OSError, ValueError, KeyError, TypeError):
            return None
        if (value.get('version') != 1 or value.get('repository') != self.current['repository']
                or value.get('snapshot') not in self.current['verified']
                or not isinstance(value.get('inventory'), dict)
                or not isinstance(value['inventory'].get('files'), dict)
                or datetime.now(timezone.utc) - full_at > FULL_CHECK_AGE):
            return None
        return value

    def record_check(self, root, snapshot, inv, full_at):
        path = self.check_path(root)
        path.parent.mkdir(mode=0o700, exist_ok=True)
        atomic_private(path, json.dumps({'version': 1, 'repository': self.current['repository'],
                                         'snapshot': snapshot['id'], 'full_at': full_at,
                                         'inventory': inv}).encode())

    def dump_sha256(self, snapshot, relative, limit):
        """SHA-256 of one file read back out of the snapshot (restic checks each piece's MAC)."""
        private_file(Path(self.current['key']))
        command = ['/usr/bin/restic', '--repo', self.repository(self.current['repository']),
                   '--password-file', self.current['key'], '--quiet', 'dump', snapshot['id'],
                   snapshot['path'] + '/' + relative]
        digest, size = hashlib.sha256(), 0
        with subprocess.Popen(command, env=self.env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL) as process:
            while chunk := process.stdout.read(1024 * 1024):
                size += len(chunk)
                require(size <= limit, 'A file read back from the backup is larger than saved; not verified.')
                digest.update(chunk)
            require(process.wait(timeout=1800) == 0, 'A changed file could not be read back from the backup.')
        return size, digest.hexdigest()

    def check_changed(self, snapshot, original, previous, profile):
        """Read back only what changed since the last checked snapshot. The snapshot's list of
        files and sizes must be the book's, its manifest must be this backup's, and every changed
        file must hash as saved. Unchanged files are the same pieces the last complete restore
        read back; the weekly complete restore catches anything that went bad since."""
        changed = sorted(p for p, v in original['files'].items() if previous['files'].get(p) != v)
        prefix = snapshot['path'].rstrip('/') + '/'
        files, directories = {}, set()
        for line in self.restic(['ls', snapshot['id']]).splitlines():
            node = json.loads(line) if line.strip() else {}
            path = node.get('path', '') if isinstance(node, dict) else ''
            if 'node' not in (node.get('struct_type'), node.get('message_type')) or not path.startswith(prefix):
                continue
            relative = path[len(prefix):]
            if relative == MANIFEST or relative == PROFILE or relative.startswith(PROFILE + '/'):
                continue
            if node.get('type') == 'dir':
                directories.add(relative)
            else:
                require(node.get('type') == 'file', 'The backup holds something other than files and folders.')
                files[relative] = node.get('size')
        require(files == {p: v['bytes'] for p, v in original['files'].items()}
                and directories == set(original['directories']),
                "The backup's list of files differs from the book; not verified.")
        manifest = json.loads(run('/usr/bin/restic', ['--repo', self.repository(self.current['repository']),
                                                      '--password-file', self.current['key'], '--quiet', 'dump',
                                                      snapshot['id'], prefix + MANIFEST], self.env))
        require(isinstance(manifest, dict) and manifest.get('inventory') == original
                and manifest.get('profile') == profile, "The backup's manifest differs; not verified.")
        for relative in changed:
            expected = original['files'][relative]
            require(self.dump_sha256(snapshot, relative, expected['bytes']) == (expected['bytes'], expected['sha256']),
                    'A changed file read back from the backup differs; not verified.')
        return len(changed)

    def validate_project_root(self, project):
        root = Path(project).resolve(strict=True)
        require(root.is_dir() and (root/'manuscript').is_dir(), 'Select a saved Grimoire project with a manuscript folder.')
        require(not (root/'.git').is_file(), 'A linked Git worktree cannot be backed up portably; use a self-contained book folder.')
        require(not (root/MANIFEST).exists() and not (root/MANIFEST).is_symlink(), 'Reserved backup manifest name already exists in the project.')
        require(not (root/PROFILE).exists() and not (root/PROFILE).is_symlink(), 'Reserved backup settings name already exists in the project.')
        require(not self.state.resolve().is_relative_to(root), 'Backup credentials/state must be outside the project.')
        return root

    def enqueue_project(self, root, inv, error_note=''):
        digest = inventory_digest(inv)
        label = ''.join(c for c in root.name if c.isprintable())[:80] or 'Book'
        project_str = str(root)
        for item in self.queue:
            if item['project'] == project_str:
                item['label'] = label
                item['inventory_sha256'] = digest
                item['queued_at'] = now()
                if error_note:
                    item['attempts'] = min(item['attempts'] + 1, 2**32 - 1)
                    item['last_error'] = error_note[:256]
                self.save_queue()
                return item
        require(len(self.queue) < 64, 'Offline backup queue is full (64 items maximum).')
        entry = {
            'id': secrets.token_hex(8),
            'project': project_str,
            'label': label,
            'queued_at': now(),
            'attempts': 1 if error_note else 0,
            'last_error': error_note[:256],
            'inventory_sha256': digest,
        }
        self.queue.append(entry)
        self.save_queue()
        return entry

    def dequeue_project(self, root):
        project_str = str(root)
        before = len(self.queue)
        self.queue = [item for item in self.queue if item['project'] != project_str]
        if len(self.queue) != before:
            self.save_queue()

    def queue_backup(self, project):
        root = self.validate_project_root(project)
        original = inventory(root)
        require(inventory(root) == original, 'Project changed while reading; save and retry.')
        self.enqueue_project(root, original, '')
        return self.status(
            f'Project queued for encrypted backup ({len(self.queue)} pending). Run queued backups when your repository is reachable.',
            refresh=False)

    def clear_queue(self):
        self.queue = []
        self.save_queue()
        return self.status('Cleared pending backup queue. Existing snapshots and manuscripts are unchanged.', refresh=False)

    def run_queue(self):
        require(self.current is not None, 'Set up a backup repository first.')
        if not self.queue:
            return self.status('No queued backups are pending.', refresh=False)
        for item in list(self.queue):
            attempts = item['attempts']
            try:
                root = self.validate_project_root(item['project'])
                original = inventory(root)
                require(inventory(root) == original, 'Project changed while reading; save and retry.')
                digest = inventory_digest(original)
                # Match this durable operation ID, not the display name of a
                # possibly different project. Restic requires BOTH tags here.
                existing = self.snapshots(queue_id=item['id'])
                recovered = False
                for candidate in existing:
                    with tempfile.TemporaryDirectory(prefix='wros-backup-verify-', dir=self.state) as temporary:
                        restored = Path(temporary)/'restore-check'
                        restored.mkdir(mode=0o700)
                        actual, _ = self.restore_into(candidate, restored)
                        if inventory_digest(actual) == digest:
                            self.current['verified'][candidate['id']] = now()
                            self.save()
                            self.dequeue_project(root)
                            recovered = True
                            break
                if not recovered:
                    self.backup(str(root))
            except Exception:
                pending = next((q for q in self.queue if q['id'] == item['id']), None)
                if pending is not None:
                    pending['attempts'] = min(max(pending['attempts'], attempts + 1), 2**32 - 1)
                    pending['last_error'] = 'Backup or restore verification did not complete; check connectivity, saved files and repository locks, then retry.'
                    self.save_queue()
                raise ValueError('Queued backup did not complete. Pending projects remain queued; check connectivity, saved files and repository locks, then retry.') from None
        return self.status('Completed all queued backups and verified every restored file hash.')

    def backup(self, project, automatic=False):
        root = self.validate_project_root(project)
        require(self.current is not None, 'Set up a backup repository first.')
        progress('Checking the saved project')
        original = inventory(root)
        queued = self.enqueue_project(root, original)
        try:
            result = self.backup_saved(root, original, queued, automatic)
        except Exception:
            self.enqueue_project(root, original, 'Backup or restore verification did not complete; retry explicitly.')
            raise
        if automatic:
            try:
                self.prune()
            except Exception:
                result['notice'] += ' Older automatic snapshots were not pruned this time.'
        return result

    def prune(self, now=None):
        """Forget automatic snapshots outside the retention schedule, then free their space.
        The newest verified snapshot of every book is kept whatever the schedule says."""
        rows = json.loads(self.restic(['snapshots', '--tag', TAG + ',auto'])) or []
        require(isinstance(rows, list), 'Unexpected snapshot list; nothing pruned.')
        protected = {entry['id'] for entry in self.latest().values()}
        forget = [i for i in retention_forget(rows, now or datetime.now(timezone.utc))
                  if re.fullmatch('[a-f0-9]{64}', i) and i not in protected]
        if forget:
            progress('Pruning older automatic snapshots')
            self.restic(['forget', *forget])
            self.restic(['prune'])
            for identifier in forget:
                self.current['verified'].pop(identifier, None)
            self.save()
        return forget

    def backup_saved(self, root, original, queued, automatic=False):
        destination = self.repository(self.current['repository'])
        same_device = False
        if not destination.startswith('rclone:'):
            repo = Path(destination)
            require(not repo.is_relative_to(root) and not root.is_relative_to(repo), 'Backup repository and manuscript must be separate directories.')
            same_device = repo.stat().st_dev == root.stat().st_dev
        with tempfile.TemporaryDirectory(prefix='wros-backup-', dir=self.state) as temporary:
            stage = Path(temporary)/'book'
            stage.mkdir(mode=0o700)
            progress('Copying the project to private staging')
            require(inventory(root, stage) == original, 'Project changed before staging; save and retry.')
            require(inventory(root) == original, 'Project changed during staging; save and retry. No snapshot verified.')
            manifest = {'version': 1, 'created': now(), 'inventory': original}
            if self.write_profile(stage/PROFILE):
                manifest['profile'] = inventory(stage/PROFILE)
            (stage/MANIFEST).write_text(json.dumps(manifest), encoding='utf-8')
            label = ''.join(c for c in root.name if c.isprintable())[:80] or 'Book'
            tags = ['--tag', TAG, '--tag', 'project:' + label, '--tag', 'queue:' + queued['id']]
            if 'profile' in manifest:
                tags += ['--tag', 'profile']
            if automatic:
                tags += ['--tag', 'auto']
            output = self.restic(['backup', *tags, '--host', 'wros', '--', str(stage)], stage,
                                 phase='Encrypting and saving the snapshot')
            summaries = [json.loads(line) for line in output.splitlines() if line.strip()]
            identifier = next((row.get('snapshot_id') for row in summaries if row.get('message_type') == 'summary'), None)
            require(identifier, 'Backup did not return a complete snapshot; no verification claimed.')
            snapshot = next((row for row in self.snapshots() if row['id'].startswith(identifier)), None)
            require(snapshot is not None, 'New snapshot cannot be found; no verification claimed.')
            previous = self.last_check(root) if automatic else None
            changed = None
            if previous and sum(1 for p, v in original['files'].items()
                                if previous['inventory']['files'].get(p) != v) <= CHANGED_CHECK_LIMIT:
                progress('Reading back the changed files')
                try:
                    changed = self.check_changed(snapshot, original, previous['inventory'], manifest.get('profile'))
                    full_at = previous['full_at']
                except (ValueError, OSError, subprocess.SubprocessError):
                    changed = None  # The complete restore below decides.
            if changed is None:
                restored = Path(temporary)/'restore-check'
                restored.mkdir(mode=0o700)
                require(self.restore_into(snapshot, restored)[0] == original, 'Restore check differs from the saved project.')
                full_at = now()
            self.record_check(root, snapshot, original, full_at)
            self.current['verified'][snapshot['id']] = now()
            self.save()
            self.record_latest(root, snapshot)
            self.dequeue_project(root)
        if changed is None:
            message = 'Backup verified by a complete restore; all file hashes match.'
        else:
            message = (f'Backup checked: {changed} changed file{"" if changed == 1 else "s"} read back and '
                       f'matched; the rest matched the complete restore on {full_at[:10]}.')
        if same_device:
            message += ' Destination is on the same filesystem; keep an off-device copy too.'
        return self.status(message)

    def write_profile(self, target):
        """Grimoire's own files (regular files only, each at most 1 MiB) and the keyboard layout and
        timezone. True when there was anything to save."""
        files, total = [], 0
        if self.profile_config.is_dir() and not self.profile_config.is_symlink():
            for path in sorted(self.profile_config.iterdir()):
                if path.is_symlink() or not path.is_file():
                    continue
                size = path.stat().st_size
                if size > PROFILE_FILE_LIMIT or total + size > PROFILE_TOTAL_LIMIT:
                    continue
                files.append(path)
                total += size
        system = {'version': 1, 'keyboard': None, 'timezone': None}
        try:
            layout = json.loads(self.keyboard_file.read_text(encoding='utf-8')).get('layout')
            system['keyboard'] = layout if isinstance(layout, str) and re.fullmatch('[a-z0-9-]{1,32}', layout) else None
        except (OSError, ValueError, AttributeError):
            pass
        try:
            zone = self.timezone_file.read_text(encoding='utf-8').strip()
            system['timezone'] = zone if re.fullmatch('[A-Za-z0-9_+/-]{1,64}', zone) else None
        except OSError:
            pass
        if not files and system['keyboard'] is None and system['timezone'] is None:
            return False
        (target/'grimoire').mkdir(parents=True, mode=0o700)
        for path in files:
            (target/'grimoire'/path.name).write_bytes(path.read_bytes())
        (target/'system.json').write_text(json.dumps(system, sort_keys=True), encoding='utf-8')
        return True

    def apply_profile(self, profile):
        """Put grimoire's saved files back, keeping the current ones in a dated folder first."""
        saved = sorted(p for p in (profile/'grimoire').iterdir() if p.is_file() and not p.is_symlink()) \
            if (profile/'grimoire').is_dir() else []
        config = self.profile_config
        require(not config.is_symlink(), 'The settings folder is a symbolic link; nothing restored.')
        config.mkdir(parents=True, exist_ok=True, mode=0o700)
        kept = config/('before-restore-' + datetime.now().strftime('%Y-%m-%d %H.%M.%S'))
        current = [p for p in config.iterdir() if p.is_file() and not p.is_symlink()]
        if current:
            kept.mkdir(mode=0o700)
            for path in current:
                shutil.copy2(path, kept/path.name)
        for path in saved:
            temporary = config/('.' + path.name + '.' + secrets.token_hex(4))
            temporary.write_bytes(path.read_bytes())
            os.replace(temporary, config/path.name)
        try:
            system = json.loads((profile/'system.json').read_text(encoding='utf-8'))
        except (OSError, ValueError):
            system = {}
        message = f' Settings restored ({len(saved)} file(s)).'
        if current:
            message += f' Your previous settings are kept in {kept}.'
        hints = []
        if isinstance(system.get('keyboard'), str):
            hints.append('keyboard ' + system['keyboard'])
        if isinstance(system.get('timezone'), str):
            hints.append('timezone ' + system['timezone'])
        if hints:
            message += ' The backup was made with ' + ' and '.join(hints) + '; set them in Settings if they differ.'
        return message

    def restore(self, identifier, destination, settings=False):
        require(re.fullmatch('[a-f0-9]{64}', identifier or ''), 'Choose an exact snapshot from the refreshed list.')
        target = safe_new_path(destination)
        require(not target.is_relative_to(self.state.resolve()), 'Restore outside backup state/credentials.')
        if self.current and not self.current['repository'].startswith('drive:'):
            require(not target.is_relative_to(Path(self.repository(self.current['repository']))), 'Restore outside the repository.')
        snapshot = next((row for row in self.snapshots() if row['id'] == identifier), None)
        require(snapshot is not None, 'Snapshot no longer available; refresh the list.')
        stage = Path(tempfile.mkdtemp(prefix='.wros-restore-incomplete-', dir=target.parent))
        profile = None
        try:
            try:
                _, profile = self.restore_into(snapshot, stage, phase="Restoring the snapshot")
                publish_directory(stage, target)
            except Exception:
                # Preserve interrupted/failed restores under an explicit incomplete
                # name. Nothing is opened as a verified restored book automatically.
                raise ValueError('Restore incomplete; original book unchanged. Review ' + str(stage)) from None
            self.current['verified'][identifier] = now()
            self.save()
            message = 'Restore verified and saved in ' + str(target) + '. Open that folder explicitly to review it.'
            if settings:
                message += self.apply_profile(profile) if profile else ' This backup has no settings saved with it.'
        finally:
            if profile is not None:
                shutil.rmtree(profile, ignore_errors=True)
        return self.status(message)

    def export_key(self, destination):
        require(self.current is not None, 'Connect a repository first.')
        target = safe_new_path(destination)
        require(not target.is_relative_to(self.state.resolve()), 'Keep the recovery copy outside this machine backup state.')
        if not self.current['repository'].startswith('drive:'):
            require(not target.is_relative_to(Path(self.repository(self.current['repository']))), 'Keep the recovery key separate from the encrypted repository.')
        source = private_file(Path(self.current['key']))
        write_private(target, source.read_bytes(), exclusive=True)
        return self.status('Recovery key exported to ' + str(target) + '. Keep it private and separate from the repository.', refresh=False)

    def google_clients(self):
        """WrOS's Google clients, or None in a build without them."""
        try:
            clients = json.loads(self.clients_path.read_text(encoding='utf-8'))
        except (OSError, ValueError):
            return None
        ok = isinstance(clients, dict) and all(
            isinstance(clients.get(name), dict)
            and all(isinstance(clients[name].get(key), str) and clients[name][key] for key in ('client_id', 'client_secret'))
            for name in ('linking', 'mailbox'))
        return clients if ok else None

    def link_phone(self):
        clients = self.google_clients()
        require(clients is not None, 'This copy of WrOS has no Google sign-in client, so Google Drive can be '
                                     'linked only from another computer (Connect Google Drive from a trusted computer).')
        link = load_link()
        host = link.local_address()
        listener = link.Listener(host) if host and link.Listener else None
        session = link.Link(clients, listener=listener,
                            offer=lambda offer: progress('Waiting for your phone', offer=offer))
        try:
            token, via = session.run()
            progress('Checking the link with Google Drive')
            self.connect_google(json.dumps(token), client=clients['linking'])
        except Exception:
            session.fail('WrOS did not link. Look at the laptop for the reason, then scan its code again.')
            raise
        session.finish(token, via)
        return self.status('Google Drive linked from your phone. WrOS can now see your whole Drive.', refresh=False)

    def connect_google(self, authorization, client=None):
        require(isinstance(authorization, str) and len(authorization) <= 32768, 'Authorization response is too large.')
        token = json.loads(authorization)
        require(isinstance(token, dict) and isinstance(token.get('access_token'), str)
                and isinstance(token.get('refresh_token'), str) and token['refresh_token']
                and isinstance(token.get('expiry'), str), 'Paste the authorization JSON returned by rclone authorize drive.')
        config = configparser.ConfigParser(interpolation=None)
        config['wros-google'] = {'type': 'drive', 'token': json.dumps(token), 'scope': 'drive'}
        if client:  # Google renews a token only for the client that issued it
            config['wros-google']['client_id'] = client['client_id']
            config['wros-google']['client_secret'] = client['client_secret']
        import io
        output = io.StringIO()
        config.write(output)
        candidate = self.state/('google-' + secrets.token_hex(8) + '.conf')
        try:
            write_private(candidate, output.getvalue().encode(), exclusive=True)
            env = dict(self.env, RCLONE_CONFIG=str(candidate))
            # Explicit enrollment alone contacts Google. Do not call providers
            # when merely opening Settings/status or running local backups.
            ok, payload, failure_kind = classify_rclone_failure(['about', 'wros-google:', '--json'], env)
            require(ok, google_connect_failure(failure_kind))
            quota = json.loads(payload)
            require(isinstance(quota, dict) and 'total' in quota, 'Google Drive authorization could not be verified.')
            atomic_private(self.google, candidate.read_bytes())
            ts = now()
            self.google_meta = {
                'version': 1,
                'connected_at': ts,
                'verified_at': ts,
                'token_expiry': token['expiry'],
                'state': 'connected',
                'last_error': '',
            }
            self.save_account()
        finally:
            candidate.unlink(missing_ok=True)
        return self.status('Google Drive connected. Choose New Google Drive backup to create an encrypted repository.', refresh=False)

    def shared_google_client(self):
        """The connection uses rclone's built-in Google client, which every rclone user shares."""
        config = configparser.ConfigParser(interpolation=None)
        try:
            config.read_string(self.google.read_text(encoding='utf-8'))
            return not config.get('wros-google', 'client_id', fallback='')
        except (OSError, configparser.Error):
            return False

    def check_google(self):
        require(self.google.exists() or self.google.is_symlink(), 'Google Drive is not connected.')
        private_file(self.google)
        ok, payload, failure_kind = classify_rclone_failure(['about', 'wros-google:', '--json'], self.env)
        ts = now()
        if not ok:
            base = self.google_meta or {
                'version': 1,
                'connected_at': ts,
                'verified_at': '',
                'token_expiry': '',
            }
            if failure_kind == 'reauthorization-required':
                base['state'] = 'reauthorization-required'
                base['last_error'] = 'Google Drive authorization expired or was revoked.'
                self.google_meta = base
                self.save_account()
                raise ValueError('Google Drive authorization expired or was revoked. Reauthorize Google Drive or disconnect local credentials.')
            if failure_kind == 'clock':
                raise ValueError(clock_message() + ' Local credentials remain saved.')
            if failure_kind == 'rate-limited':
                raise ValueError(RATE_LIMITED + ' Local credentials remain saved.')
            base['state'] = 'offline'
            base['last_error'] = 'Google Drive could not be reached.'
            self.google_meta = base
            self.save_account()
            raise ValueError('Google Drive could not be reached. Local credentials remain saved; retry when online.')
        quota = json.loads(payload)
        require(isinstance(quota, dict) and 'total' in quota, 'Google Drive quota response was invalid.')
        expiry = self.google_meta.get('token_expiry', '') if self.google_meta else ''
        try:
            parser = configparser.ConfigParser(interpolation=None)
            parser.read_string(self.google.read_text(encoding='utf-8'))
            if parser.has_option('wros-google', 'token'):
                tok = json.loads(parser.get('wros-google', 'token'))
                if isinstance(tok, dict) and isinstance(tok.get('expiry'), str):
                    expiry = tok['expiry']
        except Exception:
            pass
        self.google_meta = {
            'version': 1,
            'connected_at': (self.google_meta or {}).get('connected_at', ts),
            'verified_at': ts,
            'token_expiry': expiry,
            'state': 'connected',
            'last_error': '',
        }
        self.save_account()
        return self.status('Google Drive connection verified; credentials are active.', refresh=False)

    def disconnect_google(self):
        require(not self.google.is_symlink(), 'Refusing to remove symlinked Google configuration.')
        ended = False
        if self.google.exists():
            private_file(self.google)
            # A link made from the phone used WrOS's own client: end that grant at Google too.
            # Connections made with rclone authorize are left to the Google account settings.
            config = configparser.ConfigParser(interpolation=None)
            try:
                config.read_string(self.google.read_text(encoding='utf-8'))
                section = config['wros-google']
                refresh = json.loads(section.get('token', '{}')).get('refresh_token')
                if section.get('client_id') and isinstance(refresh, str) and refresh:
                    ended = revoke_google(refresh)
            except (configparser.Error, KeyError, ValueError, AttributeError):
                pass
            size = self.google.stat().st_size
            write_private(self.google, b'\x00' * max(size, 64), exclusive=False)
            self.google.unlink()
        self.google_meta = None
        self.save_account()
        if ended:
            return self.status('Google Drive access ended at Google and removed from this device.', refresh=False)
        return self.status(
            'Google Drive credentials removed from this device. Revoke access in your Google account settings to end the provider grant.',
            refresh=False)



    def _record_google_failure(self, failure_kind):
        ts = now()
        base = self.google_meta or {
            'version': 1,
            'connected_at': ts,
            'verified_at': '',
            'token_expiry': '',
        }
        if failure_kind == 'reauthorization-required':
            base['state'] = 'reauthorization-required'
            base['last_error'] = 'Google Drive authorization expired or was revoked.'
            self.google_meta = base
            self.save_account()
            raise ValueError('Google Drive authorization expired or was revoked. Reauthorize Google Drive or disconnect local credentials.')
        base['state'] = 'offline'
        base['last_error'] = 'Google Drive could not be reached.'
        self.google_meta = base
        self.save_account()
        raise ValueError('Google Drive could not be reached. Local credentials remain saved; retry when online.')

    def _validate_drive_subpath(self, descriptor, require_item=False):
        require(isinstance(descriptor, str) and len(descriptor) <= 1024
                and not any(ord(c) < 32 for c in descriptor), 'Invalid Google Drive folder or path.')
        require(descriptor.startswith('drive:'), 'A Google Drive path starts with drive:, for example drive:Novels.')
        # "drive:" alone is the top of the writer's Drive.
        parts = [p for p in descriptor[6:].split('/') if p]
        require(all(p not in ('.', '..') and '\0' not in p and '\\' not in p for p in parts),
                'That Google Drive path has an unsafe part.')
        if require_item:
            require(parts, 'Choose a file or folder in Google Drive to copy.')
        return '/'.join(parts)

    def drive_list(self, folder):
        sub = self._validate_drive_subpath(folder, require_item=False)
        require(self.google.exists() or self.google.is_symlink(), 'Connect Google Drive first.')
        private_file(self.google)
        ok, payload, failure_kind = classify_rclone_failure(['lsjson', 'wros-google:' + sub], self.env)
        if not ok:
            self._record_google_failure(failure_kind)
        rows = json.loads(payload) if payload.strip() else []
        require(isinstance(rows, list) and len(rows) <= 1000, 'Google Drive folder exceeds 1,000 supported entries.')
        entries = []
        for row in rows:
            require(isinstance(row, dict), 'Invalid Google Drive entry metadata.')
            name = str(row.get('Name') or row.get('Path') or '').strip()
            require(name and '/' not in name and name not in ('.', '..') and not any(ord(c) < 32 for c in name),
                    'Unsupported Google Drive entry name.')
            is_dir = bool(row.get('IsDir', False))
            size = int(row.get('Size', 0)) if not is_dir and int(row.get('Size', 0)) >= 0 else 0
            modified = str(row.get('ModTime', ''))[:32]
            rel_path = f'{sub}/{name}' if sub else name
            cache_marker = self.drive_cache / (rel_path + '.json')
            cached, local = False, ''
            if cache_marker.is_file() and not cache_marker.is_symlink():
                try:
                    cmeta = read_json(cache_marker)
                    target = Path(str(cmeta.get('local_target', '')))
                    # On this laptop while the copy is still there; up to date while Drive's matches it.
                    if target.is_absolute() and target.exists() and not target.is_symlink():
                        local = str(target)
                        cached = cmeta.get('size') == size and cmeta.get('modified') == modified
                except Exception:
                    cached, local = False, ''
            entries.append({
                'path': 'drive:' + rel_path,
                'name': name,
                'size': size,
                'modified': modified,
                'is_dir': is_dir,
                'cached': cached,
                'local': local,
                # Google Docs, Sheets and Slides have no file of their own; rclone exports them.
                'google_doc': str(row.get('MimeType', '')).startswith('application/vnd.google-apps.'),
            })
        entries.sort(key=lambda e: (not e['is_dir'], e['name'].lower()))
        self.drive_folder = 'drive:' + sub
        self.drive_entries = entries
        self.save_drive_browser()
        where = sub or 'the top of your Drive'
        return self.status(f'{len(entries)} item(s) in {where}.', refresh=False)

    def _check_copy(self, sub, payload_path):
        """The staged copy matches Google Drive, or nothing is kept."""
        if payload_path.is_dir():
            # Docs, Sheets and Slides are exported, so they have no Drive checksum to compare.
            ok, _, kind = classify_rclone_failure(
                ['check', 'wros-google:' + sub, str(payload_path), '--one-way', '--drive-skip-gdocs'], self.env)
        else:
            ok, payload, kind = classify_rclone_failure(['lsjson', '--hash', '--stat', 'wros-google:' + sub], self.env)
            if ok:
                row = json.loads(payload) if payload.strip() else {}
                remote = ((row.get('Hashes') or {}).get('md5') or '') if isinstance(row, dict) else ''
                if not remote:
                    return False  # A Google Doc: copied, but there is nothing to check it against.
                digest = hashlib.md5()
                with payload_path.open('rb') as copied:
                    for block in iter(lambda: copied.read(1 << 20), b''):
                        digest.update(block)
                ok, kind = digest.hexdigest() == remote.lower(), 'mismatch'
        if not ok:
            if kind in ('reauthorization-required', 'offline', 'rate-limited', 'clock'):
                self._record_google_failure(kind)
            raise ValueError("The copy didn't match Google Drive, so it wasn't kept. Try again.")
        return True

    def drive_materialize(self, remote, destination, project=None):
        sub = self._validate_drive_subpath(remote, require_item=True)
        target = safe_new_path(destination)
        require(not target.is_relative_to(self.state.resolve()), 'Materialize outside backup state and credentials.')
        if project:
            require(not target.is_relative_to(Path(project).resolve(strict=True)),
                    'Materialize into a new path outside the currently open project; active manuscripts stay local.')
        require(self.google.exists() or self.google.is_symlink(), 'Connect Google Drive first.')
        private_file(self.google)
        stage = Path(tempfile.mkdtemp(prefix='.wros-drive-materialize-', dir=target.parent))
        try:
            payload_path = stage / target.name
            ok, _, failure_kind = classify_rclone_failure(['copyto', 'wros-google:' + sub, str(payload_path)], self.env)
            if not ok:
                self._record_google_failure(failure_kind)
            require(payload_path.exists() and not payload_path.is_symlink(), 'Remote item was not found or is unsafe.')
            checked = self._check_copy(sub, payload_path)
            info = payload_path.lstat()
            if stat.S_ISDIR(info.st_mode):
                inv = inventory(payload_path)
                size = inv['bytes']
                publish_directory(payload_path, target)
            elif stat.S_ISREG(info.st_mode):
                require(info.st_size <= MAX_BYTES, 'Materialized file exceeds the supported 5 GiB limit.')
                size = info.st_size
                os.link(payload_path, target)
                payload_path.unlink()
                fd = os.open(target.parent, os.O_RDONLY | os.O_DIRECTORY)
                try:
                    os.fsync(fd)
                finally:
                    os.close(fd)
            else:
                raise ValueError('Materialized item is not a regular file or directory.')
        finally:
            shutil.rmtree(stage, ignore_errors=True)
        cache_marker = self.drive_cache / (sub + '.json')
        cache_marker.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        matched_mod = next((e['modified'] for e in self.drive_entries if e['path'] == 'drive:' + sub), '')
        atomic_private(cache_marker, (json.dumps({
            'version': 1,
            'remote': 'drive:' + sub,
            'local_target': str(target),
            'size': size,
            'modified': matched_mod,
            'materialized_at': now(),
        }) + '\n').encode())
        for entry in self.drive_entries:
            if entry['path'] == 'drive:' + sub:
                entry['cached'] = True
                entry['local'] = str(target)
        self.save_drive_browser()
        if checked:
            return self.status(f'Copied to {target} and checked against Google Drive.', refresh=False)
        return self.status(f'Copied to {target}. A Google Doc has nothing to check the copy against.', refresh=False)



AUTHORIZATION_LIMIT = 32768


def read_authorization_file(path):
    """The rclone authorize JSON saved as a file, for a console with no clipboard. Read as the
    writer and never echoed. A Windows editor's byte-order mark and line ending are accepted,
    and so is a `token = {...}` line copied out of an existing rclone.conf."""
    require(isinstance(path, str) and path.startswith('/'), 'Enter the authorization file as an absolute path.')
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        raise ValueError('Cannot open the authorization file. Check the path and that the drive is inserted.') from None
    if not stat.S_ISREG(os.fstat(descriptor).st_mode):
        os.close(descriptor)
        raise ValueError('The authorization file must be a regular file.')
    with os.fdopen(descriptor, 'rb') as stream:
        data = stream.read(AUTHORIZATION_LIMIT + 1)
    require(len(data) <= AUTHORIZATION_LIMIT, 'Authorization response is too large.')
    try:
        text = data.decode('utf-8-sig').strip()
    except UnicodeDecodeError:
        raise ValueError('The authorization file is not the text returned by rclone authorize drive.') from None
    text = re.sub(r'^token\s*=\s*', '', text)
    try:
        json.loads(text)
    except json.JSONDecodeError:
        raise ValueError('The authorization file does not hold only the JSON returned by rclone authorize drive.') from None
    return text


def dispatch(service, request):
    operation = request.get('operation')
    if operation == 'status':
        return service.status(refresh=False)
    if operation == 'list':
        return service.status('Snapshot list refreshed.')
    if operation == 'unlock':
        service.restic(['unlock'])
        return service.status('Stale repository locks removed. Active operations remain protected; retry your backup explicitly.')
    if operation == 'init':
        return service.configure(request['repository'])
    if operation == 'connect':
        return service.configure(request['repository'], request['key'])
    if operation == 'backup':
        return service.backup(request['project'])
    if operation == 'auto-backup':
        return service.backup(request['project'], automatic=True)
    if operation == 'queue':
        return service.queue_backup(request['project'])
    if operation == 'run-queue':
        return service.run_queue()
    if operation == 'clear-queue':
        return service.clear_queue()
    if operation == 'restore':
        if request.get('project'):
            target = safe_new_path(request['destination'])
            require(not target.is_relative_to(Path(request['project']).resolve(strict=True)),
                    'Restore outside the active project so the original book remains unchanged.')
        return service.restore(request['snapshot'], request['destination'], settings=request.get('settings') is True)
    if operation == 'export-key':
        return service.export_key(request['destination'])
    if operation == 'link-phone':
        return service.link_phone()
    if operation == 'connect-google':
        return service.connect_google(request['authorization'])
    if operation == 'connect-google-file':
        return service.connect_google(read_authorization_file(request['path']))
    if operation == 'check-google':
        return service.check_google()
    if operation == 'disconnect-google':
        return service.disconnect_google()
    if operation == 'drive-list':
        return service.drive_list(request['folder'])
    if operation == 'drive-materialize':
        return service.drive_materialize(request['remote'], request['destination'], request.get('project'))
    raise ValueError('Unsupported backup operation.')


def main():
    require(os.geteuid() != 0, 'Run backup as your normal writing account, never root.')
    def interrupted(signum, frame):
        raise InterruptedError('Backup interrupted')
    signal.signal(signal.SIGTERM, interrupted)
    request_bytes = sys.stdin.buffer.read(65537)
    require(len(request_bytes) <= 65536, 'Backup request is too large.')
    request = json.loads(request_bytes)
    state = Path(os.environ.get('WROS_BACKUP_STATE_DIR', str(Path(os.environ.get('XDG_DATA_HOME', str(Path.home()/'.local/share')))/'grimoire/wros/backup')))
    service = Service(state)
    lock = os.open(state/'operation.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        # Read after acquiring the cross-process operation lock.
        service = Service(state)
        result = dispatch(service, request)
        print(json.dumps({'ok': True, 'data': result}), flush=True)
    finally:
        os.close(lock)


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        # Never echo parse errors, upstream output, or arbitrary request text:
        # authorization JSON and secrets are only allowed on the input side.
        message = str(error) if isinstance(error, ValueError) and not isinstance(error, json.JSONDecodeError) else 'Backup operation unavailable. Check settings, permissions, connection and free space, then retry.'
        print(json.dumps({'ok': False, 'error': message}), flush=True)
        sys.exit(1)
